---
/* Zentrale Buchungsseite: direkt die erste öffentliche Terminart des Büros mit Kalender. */
import Oeffentlich from '../layouts/Oeffentlich.astro';
import BuchungsSeite from '../components/BuchungsSeite.astro';
import Icon from '../components/ui/Icon.astro';
import { buero, terminartenVon } from '../lib/abfragen';
import { KONTAKT } from '../lib/marke';

const gastgeber = await buero();
if (!gastgeber) return Astro.redirect('/app/setup');
const arten = await terminartenVon(gastgeber.id, true);
const terminart = arten[0];
---
<Oeffentlich
  titel="Termin buchen | That's it. Marketing"
  beschreibung="Buche dein Gespräch mit That's it. Marketing aus Gelsenkirchen direkt online: freie Termine im Kalender, Bestätigung mit Meet Link per Mail."
  indexieren
  bild
>
  {terminart ? (
    <BuchungsSeite gastgeber={gastgeber} terminart={terminart} arten={arten} />
  ) : (
    <div class="karte leer">
      <h1>Lass uns reden<span class="punkt">.</span></h1>
      <p class="hinweis"><Icon name="info" />Gerade sind keine Termine online buchbar. Schreib uns an <a href={`mailto:${KONTAKT.email}`}>{KONTAKT.email}</a> oder ruf an unter {KONTAKT.telefon}.</p>
    </div>
  )}
</Oeffentlich>

<style>
  .leer { padding: var(--raum-8); display: grid; gap: var(--raum-6); }
</style>
