---
/*
 * Alte Links /{nutzer}/{terminart} aus der Zeit vor der zentralen Buchung.
 * Gibt es beim Büro eine Terminart mit gleichem Link, geht es dorthin, sonst auf die Startseite.
 * Parameter wie embed, umbuchen, name und email bleiben erhalten.
 */
import { buero, terminartNachSlug } from '../../lib/abfragen';

const gastgeber = await buero();
const ziel = gastgeber ? await terminartNachSlug(gastgeber.id, Astro.params.terminart ?? '') : null;
return Astro.redirect(`/${ziel && ziel.aktiv ? ziel.slug : ''}${Astro.url.search}`, 301);
---
