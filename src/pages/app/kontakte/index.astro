---
import App from '../../../layouts/App.astro';
import Avatar from '../../../components/Avatar.astro';
import Icon from '../../../components/ui/Icon.astro';
import {
  KONTAKT_FILTER, KONTAKT_SORTIERUNG, kontaktAbfrage, kontakteImportieren,
  type KontaktFilter, type KontaktSortierung,
} from '../../../lib/kontakte';
import { meldungAusUrl } from '../../../lib/meldungen';
import { playbookStandVonKontakten } from '../../../lib/playbooks';
import { datumInZone, formatDatumMittel, formatZeit } from '../../../lib/zeit';

const nutzer = Astro.locals.gastgeber!;
const tz = nutzer.zeitzone;

// CSV Import (Datei aus Calendly, Excel oder Google Tabellen)
let importFehler = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const datei = form.get('datei');
  if (!(datei instanceof File) || datei.size === 0) importFehler = 'Bitte wähl eine CSV Datei aus.';
  else if (datei.size > 1_000_000) importFehler = 'Die Datei ist größer als 1 MB. Bitte in kleinere Dateien aufteilen.';
  else {
    const ergebnis = await kontakteImportieren(nutzer.id, await datei.text());
    if ('fehler' in ergebnis) importFehler = ergebnis.fehler!;
    else return Astro.redirect(`/app/kontakte?importiert=${ergebnis.importiert}&uebersprungen=${ergebnis.uebersprungen}`);
  }
}

const p = Astro.url.searchParams;
const suche = (p.get('suche') ?? '').trim().slice(0, 100);
const filter: KontaktFilter = KONTAKT_FILTER.includes(p.get('filter') as KontaktFilter) ? (p.get('filter') as KontaktFilter) : 'alle';
const sortierung: KontaktSortierung = KONTAKT_SORTIERUNG.includes(p.get('sort') as KontaktSortierung) ? (p.get('sort') as KontaktSortierung) : 'letztes';
const PRO_SEITE = 100;
const seite = Math.max(1, Number(p.get('seite') ?? 1) || 1);

const abfrage = kontaktAbfrage(nutzer.id, { suche, filter, sortierung });
const [zeilen, gesamt] = await Promise.all([abfrage.liste(PRO_SEITE, (seite - 1) * PRO_SEITE), abfrage.anzahl()]);
// Markierung, wie weit jemand mit einem angeforderten Playbook ist
const playbookStand = await playbookStandVonKontakten(zeilen.map((k) => k.id));
const PLAYBOOK_MARKE = { geladen: 'Playbook geladen', geoeffnet: 'Playbook geöffnet', angefordert: 'Playbook angefordert' } as const;
const seiten = Math.max(1, Math.ceil(gesamt / PRO_SEITE));
const heute = datumInZone(new Date(), tz);

const link = (aenderung: Record<string, string | null>) => {
  const q = new URLSearchParams(p);
  for (const k of ['ok', 'importiert', 'uebersprungen']) q.delete(k);
  if (!('seite' in aenderung)) q.delete('seite');
  for (const [k, v] of Object.entries(aenderung)) v === null ? q.delete(k) : q.set(k, v);
  const s = q.toString();
  return `/app/kontakte${s ? `?${s}` : ''}`;
};
const exportParams = new URLSearchParams({ ...(suche ? { suche } : {}), ...(filter !== 'alle' ? { filter } : {}), sort: sortierung });

const filterChips: { wert: KontaktFilter; text: string }[] = [
  { wert: 'alle', text: 'Alle Kontakte' },
  { wert: 'anstehend', text: 'Mit anstehendem Meeting' },
  { wert: 'neu', text: 'Neu in den letzten 30 Tagen' },
  { wert: 'ohne', text: 'Kein Meeting in den nächsten 30 Tagen' },
];
const spalten: { text: string; sort?: KontaktSortierung; klasse: string }[] = [
  { text: 'Name', sort: 'name', klasse: 's-name' },
  { text: 'E Mail', klasse: 's-mail' },
  { text: 'Telefon', klasse: 's-tel' },
  { text: 'Unternehmen', klasse: 's-firma' },
  { text: 'Letztes Meeting', sort: 'letztes', klasse: 's-letztes' },
  { text: 'Nächstes Meeting', sort: 'naechstes', klasse: 's-naechstes' },
];
const importiert = p.get('importiert');
---
<App titel="Kontakte" eyebrow={`Büro ${nutzer.email}`} meldung={meldungAusUrl(Astro.url)}>
  <Fragment slot="aktionen">
    <a class="knopf knopf--rahmen" href={`/api/app/kontakte.csv?${exportParams}`}><Icon name="download" />CSV Export</a>
    <a class="knopf knopf--orange" href="/app/kontakte/neu"><Icon name="plus" />Kontakt hinzufügen</a>
  </Fragment>

  {importiert !== null && (
    <p class="hinweis hinweis--erfolg meldung-import" role="status">
      <Icon name="check" />
      <span>{importiert} {importiert === '1' ? 'Kontakt' : 'Kontakte'} importiert oder ergänzt{Number(p.get('uebersprungen')) > 0 && `, ${p.get('uebersprungen')} Zeilen übersprungen (ohne Namen oder mit ungültiger E Mail)`}.</span>
    </p>
  )}

  <div class="werkzeuge">
    <form class="suche" method="get" role="search">
      {filter !== 'alle' && <input type="hidden" name="filter" value={filter} />}
      {sortierung !== 'letztes' && <input type="hidden" name="sort" value={sortierung} />}
      <label for="suche" class="sr-only">Kontakte durchsuchen</label>
      <Icon name="suche" groesse={18} />
      <input id="suche" name="suche" type="search" class="eingabe" placeholder="Name, E Mail, Telefon oder Unternehmen" value={suche} />
      <button class="knopf" type="submit">Suchen</button>
      {suche && <a class="knopf knopf--leise" href={link({ suche: null })}>Zurücksetzen</a>}
    </form>
    <nav class="filter" aria-label="Kontakte filtern">
      {filterChips.map((c) => (
        <a href={link({ filter: c.wert === 'alle' ? null : c.wert })} aria-current={filter === c.wert ? 'page' : undefined}>
          {filter === c.wert && <Icon name="check" groesse={16} />}{c.text}
        </a>
      ))}
    </nav>
  </div>

  <p class="anzahl leise klein" role="status">{gesamt} {gesamt === 1 ? 'Kontakt' : 'Kontakte'}</p>

  {zeilen.length === 0 ? (
    <div class="leer karte">
      <Icon name="kontakte" groesse={28} />
      <p>{suche || filter !== 'alle' ? 'Keine Kontakte passen zu Suche oder Filter.' : 'Noch keine Kontakte. Sie entstehen automatisch mit jeder Buchung und aus den Gästen im Google Kalender, oder du legst sie an oder importierst sie unten.'}</p>
    </div>
  ) : (
    <div class="tabelle karte">
      <table>
        <thead>
          <tr>
            {spalten.map((s) => (
              <th scope="col" class={s.klasse} aria-sort={s.sort && sortierung === s.sort ? (s.sort === 'letztes' ? 'descending' : 'ascending') : undefined}>
                {s.sort ? (
                  <a href={link({ sort: s.sort === 'letztes' ? null : s.sort })}>
                    {s.text}{sortierung === s.sort && <Icon name="runter" groesse={14} />}
                  </a>
                ) : s.text}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {zeilen.map((k) => (
            <tr>
              <td class="s-name" data-label="Name">
                <a class="name" href={`/app/kontakte/${k.id}`}>
                  <Avatar name={k.name} groesse={32} />
                  <span>{k.name}</span>
                </a>
                {playbookStand.get(k.id) && (
                  <span class:list={['pille', 'pb-marke', `pb-${playbookStand.get(k.id)}`]}>{PLAYBOOK_MARKE[playbookStand.get(k.id)!]}</span>
                )}
              </td>
              <td class="s-mail" data-label="E Mail">{k.email ? <a href={`mailto:${k.email}`}>{k.email}</a> : <span class="leer-wert">–</span>}</td>
              <td class="s-tel" data-label="Telefon">{k.telefon ? <a href={`tel:${k.telefon.replace(/[^\d+]/g, '')}`}>{k.telefon}</a> : <span class="leer-wert">–</span>}</td>
              <td class="s-firma" data-label="Unternehmen">{k.unternehmen ?? <span class="leer-wert">–</span>}</td>
              <td class="s-letztes" data-label="Letztes Meeting">{k.letztes ? formatDatumMittel(k.letztes, tz) : <span class="leer-wert">–</span>}</td>
              <td class="s-naechstes" data-label="Nächstes Meeting">
                {k.naechstes ? (
                  <span class="naechstes">
                    {datumInZone(new Date(k.naechstes), tz) === heute ? <span class="badge badge--orange">Heute</span> : formatDatumMittel(k.naechstes, tz)}
                    <span class="leise klein">{formatZeit(k.naechstes, tz)} Uhr</span>
                  </span>
                ) : <span class="leer-wert">–</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {seiten > 1 && (
    <nav class="seiten" aria-label="Seiten">
      {seite > 1 && <a class="knopf knopf--rahmen knopf--klein" href={link({ seite: String(seite - 1) })}><Icon name="links" />Zurück</a>}
      <span class="leise klein">Seite {seite} von {seiten}</span>
      {seite < seiten && <a class="knopf knopf--rahmen knopf--klein" href={link({ seite: String(seite + 1) })}>Weiter<Icon name="rechts" /></a>}
    </nav>
  )}

  <details class="import karte" open={Boolean(importFehler)}>
    <summary><Icon name="upload" />Kontakte importieren (CSV)</summary>
    <form method="post" enctype="multipart/form-data" class="import-form">
      <p class="leise klein">
        Erste Zeile mit Spaltennamen, darunter ein Kontakt pro Zeile. Erkannt werden Name (oder Vorname und Nachname), E Mail, Telefon,
        Unternehmen, Notiz und „Datum des letzten Meetings“, getrennt durch Semikolon, Komma oder Tab. Vorhandene Kontakte werden nur ergänzt, nie überschrieben.
      </p>
      {importFehler && <p class="hinweis hinweis--fehler" role="alert"><Icon name="warnung" />{importFehler}</p>}
      <div class="import-zeile">
        <label for="datei" class="sr-only">CSV Datei</label>
        <input id="datei" name="datei" type="file" accept=".csv,text/csv,text/plain" required />
        <button class="knopf knopf--rahmen" type="submit"><Icon name="upload" />Importieren</button>
      </div>
    </form>
  </details>
</App>

<style>
  .meldung-import { margin-bottom: var(--raum-6); }
  .werkzeuge { display: grid; gap: var(--raum-4); }
  .suche { display: flex; align-items: center; gap: var(--raum-2); position: relative; max-width: 720px; }
  .suche > :global(svg) { position: absolute; left: 12px; color: var(--n-500); pointer-events: none; }
  .suche .eingabe { padding-left: 38px; flex: 1; min-width: 0; }
  .filter { display: flex; flex-wrap: wrap; gap: var(--raum-2); }
  .filter a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 var(--raum-4); border: 1px solid var(--farbe-rahmen);
    background: var(--farbe-papier); text-decoration: none; font-size: var(--text-sm); font-weight: 500; border-radius: var(--radius-s);
  }
  .filter a:hover { border-color: var(--n-900); }
  .filter a[aria-current='page'] { background: var(--n-900); border-color: var(--n-900); color: var(--farbe-papier); }
  .anzahl { margin: var(--raum-4) 0; }
  .leer { padding: var(--raum-12); display: grid; justify-items: center; gap: var(--raum-3); text-align: center; color: var(--farbe-text-2); }
  .leer p { max-width: 60ch; }

  .tabelle { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  th, td { text-align: left; padding: var(--raum-3) var(--raum-4); border-bottom: 1px solid var(--farbe-rahmen); vertical-align: middle; }
  th + th, td + td { border-left: 1px solid var(--farbe-rahmen); }
  thead th { background: var(--n-050); font-weight: 600; white-space: nowrap; height: 52px; }
  thead th a { display: inline-flex; align-items: center; gap: 4px; text-decoration: none; }
  thead th a:hover { text-decoration: underline; }
  tbody tr:hover { background: var(--n-050); }
  tbody tr:last-child td { border-bottom: 0; }
  .name { display: inline-flex; align-items: center; gap: var(--raum-3); font-weight: 600; text-decoration: none; color: var(--n-900); }
  .name:hover span { text-decoration: underline; text-decoration-color: var(--farbe-akzent); }
  td a:not(.name) { color: var(--farbe-text-2); text-decoration: none; }
  td a:not(.name):hover { color: var(--n-900); text-decoration: underline; }
  .s-mail { overflow-wrap: anywhere; }
  .s-tel, .s-letztes, .s-naechstes { white-space: nowrap; }
  .naechstes { display: inline-flex; align-items: baseline; gap: var(--raum-2); font-weight: 600; }
  .naechstes .badge { padding: 1px 8px; font-size: 0.75rem; }
  .pb-marke { display: flex; width: fit-content; margin: 4px 0 0 calc(32px + var(--raum-3)); padding: 1px 8px; font-size: 0.75rem; }
  .pb-geladen { background: var(--farbe-erfolg-flaeche); color: var(--farbe-erfolg-text); }
  .pb-geoeffnet { background: var(--n-100); color: var(--n-700); }
  .pb-angefordert { background: transparent; color: var(--farbe-text-leise); box-shadow: inset 0 0 0 1px var(--farbe-rahmen); }
  .leer-wert { color: var(--n-300); }

  .seiten { display: flex; justify-content: center; align-items: center; gap: var(--raum-4); margin-top: var(--raum-6); }
  .import { margin-top: var(--raum-8); padding: 0; }
  .import summary { display: flex; align-items: center; gap: var(--raum-2); padding: var(--raum-4) var(--raum-6); cursor: pointer; font-weight: 600; list-style: none; }
  .import summary::-webkit-details-marker { display: none; }
  .import[open] summary { border-bottom: 1px solid var(--farbe-rahmen); }
  .import-form { display: grid; gap: var(--raum-4); padding: var(--raum-4) var(--raum-6) var(--raum-6); max-width: 80ch; }
  .import-zeile { display: flex; flex-wrap: wrap; gap: var(--raum-3); align-items: center; }
  .import-zeile input[type='file'] { max-width: 100%; font-size: var(--text-sm); }

  /* Schmale Bildschirme: jede Zeile als Karte */
  @media (max-width: 900px) {
    .tabelle { overflow: visible; background: none; border: 0; box-shadow: none; }
    table, tbody, tr, td { display: block; }
    thead { display: none; }
    tbody { display: grid; gap: var(--raum-3); }
    tbody tr { background: var(--farbe-papier); border: 1px solid var(--farbe-rahmen); padding: var(--raum-3) var(--raum-4); display: grid; grid-template-columns: 1fr 1fr; gap: var(--raum-2) var(--raum-4); }
    tbody tr:hover { background: var(--farbe-papier); }
    td, td + td { border: 0; padding: 0; min-width: 0; }
    td.s-name, td.s-mail { grid-column: 1 / -1; }
    td:not(.s-name)::before { content: attr(data-label); display: block; font-size: 0.75rem; color: var(--farbe-text-leise); }
    td.s-firma:has(.leer-wert), td.s-tel:has(.leer-wert) { display: none; }
    .suche { flex-wrap: wrap; }
    .suche .eingabe { flex-basis: 100%; }
    .suche > :global(svg) { top: 13px; }
  }
</style>
