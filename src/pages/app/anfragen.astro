---
/**
 * Anfragen über Landingpages, die keine Playbooks sind (seit 2026-11-16, erste Quelle:
 * Website Entwurf Funnel). Eine Zeile je Anfrage mit Quelle, E Mail, Telefon und den Angaben
 * aus dem Funnel. Reiter je Quelle, Suche, CSV Export. Name führt in den Kontakt.
 */
import App from '../../layouts/App.astro';
import Avatar from '../../components/Avatar.astro';
import Icon from '../../components/ui/Icon.astro';
import { ANFRAGE_QUELLEN, anfrageAbfrage, anfrageAntworten, anfragenJeQuelle, istAnfrageQuelle, type AnfrageQuelle } from '../../lib/anfragen';
import { formatDatumMittel, formatZeit } from '../../lib/zeit';

const nutzer = Astro.locals.gastgeber!;
const tz = nutzer.zeitzone;
const p = Astro.url.searchParams;
const quelle: AnfrageQuelle | null = istAnfrageQuelle(p.get('quelle')) ? (p.get('quelle') as AnfrageQuelle) : null;
const suche = (p.get('suche') ?? '').trim().slice(0, 100);
const PRO_SEITE = 100;
const seite = Math.max(1, Number(p.get('seite') ?? 1) || 1);

const abfrage = anfrageAbfrage(nutzer.id, { quelle, suche });
const [zeilen, gesamt, jeQuelle] = await Promise.all([abfrage.liste(PRO_SEITE, (seite - 1) * PRO_SEITE), abfrage.anzahl(), anfragenJeQuelle(nutzer.id)]);
const alleAnzahl = [...jeQuelle.values()].reduce((a, b) => a + b, 0);
const seiten = Math.max(1, Math.ceil(gesamt / PRO_SEITE));

const link = (aenderung: Record<string, string | null>) => {
  const q = new URLSearchParams(p);
  if (!('seite' in aenderung)) q.delete('seite');
  for (const [k, v] of Object.entries(aenderung)) v === null ? q.delete(k) : q.set(k, v);
  const s = q.toString();
  return `/app/anfragen${s ? `?${s}` : ''}`;
};
const exportParams = new URLSearchParams({ ...(quelle ? { quelle } : {}), ...(suche ? { suche } : {}) });
---
<App titel="Anfragen" eyebrow="Leads über die Landingpages">
  <Fragment slot="aktionen">
    <a class="knopf knopf--rahmen" href={`${Astro.url.pathname}${Astro.url.search}`}><Icon name="aktualisieren" />Aktualisieren</a>
    <a class="knopf knopf--rahmen" href={`/api/app/anfragen.csv${exportParams.size ? `?${exportParams}` : ''}`}><Icon name="download" />CSV Export</a>
  </Fragment>

  <nav class="reiter" aria-label="Nach Quelle">
    <a href={link({ quelle: null })} aria-current={!quelle ? 'page' : undefined}>Alle Quellen <span class="zahl">{alleAnzahl}</span></a>
    {(Object.keys(ANFRAGE_QUELLEN) as AnfrageQuelle[]).map((s) => (
      <a href={link({ quelle: s })} aria-current={quelle === s ? 'page' : undefined}>
        <span class:list={['farbe', `q-${s}`]} aria-hidden="true"></span>{ANFRAGE_QUELLEN[s].name} <span class="zahl">{jeQuelle.get(s) ?? 0}</span>
      </a>
    ))}
  </nav>

  <div class="werkzeuge">
    <form class="suche" method="get" role="search">
      {quelle && <input type="hidden" name="quelle" value={quelle} />}
      <label for="suche" class="sr-only">Anfragen durchsuchen</label>
      <Icon name="suche" groesse={18} />
      <input id="suche" name="suche" type="search" class="eingabe" placeholder="Name, E Mail oder Unternehmen" value={suche} />
      <button class="knopf" type="submit">Suchen</button>
      {suche && <a class="knopf knopf--leise" href={link({ suche: null })}>Zurücksetzen</a>}
    </form>
  </div>

  <p class="anzahl leise klein" role="status">{gesamt} {gesamt === 1 ? 'Anfrage' : 'Anfragen'}</p>

  {zeilen.length === 0 ? (
    <div class="leer karte">
      <Icon name="mail" groesse={28} />
      <p>{alleAnzahl === 0 ? 'Noch keine Anfragen. Sobald jemand den Funnel auf website-entwurf.thatsit.marketing abschickt, steht die Anfrage hier.' : 'Keine Anfragen passen zur Suche.'}</p>
    </div>
  ) : (
    <div class="tabelle karte">
      <table>
        <thead>
          <tr>
            <th scope="col" class="s-name">Name</th>
            <th scope="col" class="s-pb">Quelle</th>
            <th scope="col" class="s-mail">E Mail</th>
            <th scope="col" class="s-tel">Telefon</th>
            <th scope="col" class="s-angaben">Angaben</th>
            <th scope="col" class="s-zeit">Eingegangen</th>
          </tr>
        </thead>
        <tbody>
          {zeilen.map((z) => {
            const name = z.kontakt_name ?? z.name;
            const firma = z.kontakt_unternehmen ?? z.unternehmen;
            const telefon = z.kontakt_telefon ?? z.telefon;
            const schluessel = istAnfrageQuelle(z.quelle) ? z.quelle : null;
            const antworten = anfrageAntworten(z);
            return (
              <tr>
                <td class="s-name" data-label="Name">
                  {z.kontakt_id ? (
                    <a class="name" href={`/app/kontakte/${z.kontakt_id}#anfragen`}><Avatar name={name} groesse={32} /><span>{name}</span></a>
                  ) : (
                    <span class="name"><Avatar name={name} groesse={32} /><span>{name}</span></span>
                  )}
                  {firma && <span class="unter leise">{firma}</span>}
                </td>
                <td class="s-pb" data-label="Quelle">
                  <span class="pb"><span class:list={['farbe', schluessel && `q-${schluessel}`]} aria-hidden="true"></span>{schluessel ? ANFRAGE_QUELLEN[schluessel].name : z.quelle}</span>
                  {z.dublette === 1 && <span class="unter-pb leise" title="Dieselbe E Mail oder Nummer kam in den 30 Tagen davor schon einmal">Wiederholte Anfrage</span>}
                  {z.whatsapp_gespraech_id && (
                    <a class="pille pille--erfolg wa" href={`/app/whatsapp/${z.whatsapp_gespraech_id}`} title="Der WhatsApp Bot führt das Setting, niemand muss anrufen">Per WhatsApp übernommen</a>
                  )}
                </td>
                <td class="s-mail" data-label="E Mail"><a href={`mailto:${z.email}`}>{z.email}</a></td>
                <td class="s-tel" data-label="Telefon">{telefon ? <a href={`tel:${telefon.replace(/[^\d+]/g, '')}`}>{telefon}</a> : <span class="leer-wert">–</span>}</td>
                <td class="s-angaben" data-label="Angaben">
                  {antworten.length > 0
                    ? <dl class="angaben">{antworten.map((a) => <div><dt>{a.frage}</dt><dd>{a.antwort}</dd></div>)}</dl>
                    : <span class="leer-wert">–</span>}
                </td>
                <td class="s-zeit" data-label="Eingegangen">{formatDatumMittel(z.erstellt_am, tz)}<span class="datum leise">{formatZeit(z.erstellt_am, tz)} Uhr</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  {seiten > 1 && (
    <nav class="seiten" aria-label="Seiten">
      {seite > 1 && <a class="knopf knopf--rahmen knopf--klein" href={link({ seite: String(seite - 1) })}><Icon name="links" />Zurück</a>}
      <span class="leise klein">Seite {seite} von {seiten}</span>
      {seite < seiten && <a class="knopf knopf--rahmen knopf--klein" href={link({ seite: String(seite + 1) })}>Weiter<Icon name="rechts" /></a>}
    </nav>
  )}
</App>

<style>
  .stand { align-self: center; white-space: nowrap; }
  .reiter { display: flex; flex-wrap: wrap; gap: 0 var(--raum-6); border-bottom: 1px solid var(--farbe-rahmen); margin-bottom: var(--raum-6); }
  .reiter a { display: inline-flex; align-items: center; gap: 8px; padding: var(--raum-3) 0; margin-bottom: -1px; border-bottom: 2px solid transparent; text-decoration: none; font-weight: 500; color: var(--farbe-text-2); white-space: nowrap; }
  .reiter a:hover { color: var(--n-900); }
  .reiter a[aria-current='page'] { color: var(--n-900); font-weight: 600; border-bottom-color: var(--farbe-akzent); }
  .zahl { font-size: 0.75rem; font-weight: 600; padding: 1px 7px; background: var(--n-100); color: var(--n-700); border-radius: var(--radius-pille); }
  /* Ein Farbpunkt je Playbook, damit man die Herkunft in der Liste sofort sieht */
  .farbe { display: inline-block; width: 10px; height: 10px; flex: none; background: var(--n-400); }
  .q-website-entwurf { background: #2B6CB0; }
  .unter-pb { display: block; margin-top: 2px; font-size: 0.8125rem; }
  .wa { display: block; width: fit-content; margin-top: 6px; text-decoration: none; white-space: nowrap; }

  .werkzeuge { display: grid; gap: var(--raum-4); }
  .suche { display: flex; align-items: center; gap: var(--raum-2); position: relative; max-width: 720px; }
  .suche > :global(svg) { position: absolute; left: 12px; color: var(--n-500); pointer-events: none; }
  .suche .eingabe { padding-left: 38px; flex: 1; min-width: 0; }
  .filter { display: flex; flex-wrap: wrap; gap: var(--raum-2); }
  .filter a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 var(--raum-4); border: 1px solid var(--farbe-rahmen);
    background: var(--farbe-papier); text-decoration: none; font-size: var(--text-sm); font-weight: 500; border-radius: var(--radius-s);
  }
  .filter a:hover { border-color: var(--n-900); }
  .filter a[aria-current='page'] { background: var(--n-900); border-color: var(--n-900); color: var(--farbe-papier); }
  .anzahl { margin: var(--raum-4) 0; }
  .leer { padding: var(--raum-12); display: grid; justify-items: center; gap: var(--raum-3); text-align: center; color: var(--farbe-text-2); }
  .leer p { max-width: 60ch; }

  /* Wie im CRM: Spalten werden nicht gequetscht, die Tabelle scrollt seitlich, der Name bleibt links stehen */
  .tabelle { overflow-x: auto; }
  table { width: max-content; min-width: 100%; border-collapse: separate; border-spacing: 0; font-size: var(--text-sm); }
  th, td { text-align: left; padding: var(--raum-3) var(--raum-4); border-bottom: 1px solid var(--farbe-rahmen); vertical-align: middle; white-space: nowrap; }
  .s-name { position: sticky; left: 0; z-index: 1; background: var(--farbe-papier); box-shadow: 1px 0 0 var(--farbe-rahmen); }
  thead th.s-name { background: var(--n-050); }
  tbody tr:hover td.s-name { background: var(--n-050); }
  th + th, td + td { border-left: 1px solid var(--farbe-rahmen); }
  thead th { background: var(--n-050); font-weight: 600; white-space: nowrap; height: 52px; }
  tbody tr:hover { background: var(--n-050); }
  tbody tr:last-child td { border-bottom: 0; }
  .name { display: inline-flex; align-items: center; gap: var(--raum-3); font-weight: 600; text-decoration: none; color: var(--n-900); }
  a.name:hover span { text-decoration: underline; text-decoration-color: var(--farbe-akzent); }
  .unter { display: block; margin: 2px 0 0 calc(32px + var(--raum-3)); font-size: 0.8125rem; overflow-wrap: anywhere; }
  .datum { display: block; font-size: 0.8125rem; font-weight: 400; }
  td a:not(.name) { color: var(--farbe-text-2); text-decoration: none; }
  td a:not(.name):hover { color: var(--n-900); text-decoration: underline; }
  .pb { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .ja { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--farbe-erfolg-text); }
  .leer-wert { color: var(--n-400); }
  /* Antworten aus dem Formular der Landingpage, eine Zeile je Frage */
  .angaben { margin: 0; display: grid; gap: 2px; }
  .angaben div { display: flex; gap: 6px; }
  .angaben dt { color: var(--farbe-text-leise); }
  .angaben dt::after { content: ':'; }
  .angaben dd { margin: 0; max-width: 28ch; overflow: hidden; text-overflow: ellipsis; }
  .seiten { display: flex; justify-content: center; align-items: center; gap: var(--raum-4); margin-top: var(--raum-6); }

  @media (max-width: 1000px) {
    .tabelle { overflow: visible; background: none; border: 0; box-shadow: none; }
    table, tbody, tr, td { display: block; }
    table { width: auto; min-width: 0; }
    thead { display: none; }
    tbody { display: grid; gap: var(--raum-3); }
    tbody tr { background: var(--farbe-papier); border: 1px solid var(--farbe-rahmen); padding: var(--raum-3) var(--raum-4); display: grid; grid-template-columns: 1fr 1fr; gap: var(--raum-2) var(--raum-4); }
    tbody tr:hover { background: var(--farbe-papier); }
    td, td + td { border: 0; padding: 0; min-width: 0; white-space: normal; }
    td.s-name, tbody tr:hover td.s-name { position: static; background: none; box-shadow: none; }
    td.s-mail { overflow-wrap: anywhere; }
    td.s-name, td.s-pb, td.s-mail, td.s-angaben { grid-column: 1 / -1; }
    td.s-angaben:has(.leer-wert) { display: none; }
    .angaben dd { max-width: none; overflow-wrap: anywhere; }
    .reiter { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    td:not(.s-name):not(.s-pb)::before { content: attr(data-label); display: block; font-size: 0.75rem; color: var(--farbe-text-leise); }
    td.s-tel:has(.leer-wert) { display: none; }
    .suche { flex-wrap: wrap; }
    .suche .eingabe { flex-basis: 100%; }
    .suche > :global(svg) { top: 13px; }
  }
</style>
