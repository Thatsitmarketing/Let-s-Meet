---
import App from '../../layouts/App.astro';
import Icon from '../../components/ui/Icon.astro';
import Kalender from '../../components/Kalender.astro';
import { alle, ausfuehren, db, jetztIso } from '../../lib/db';
import { kalenderLaden, kalenderParameter } from '../../lib/kalender';
import { meldungAusUrl } from '../../lib/meldungen';
import type { Ausnahme, Regel } from '../../lib/typen';
import { datumInZone, formatDatumLang, gueltigeZone, minZuZeit, WOCHENTAGE, zeitZuMin } from '../../lib/zeit';

const nutzer = Astro.locals.nutzer!;
const REIHENFOLGE = [1, 2, 3, 4, 5, 6, 0];
let fehler = '';

/** Rücksprung nach dem Speichern, Kalenderansicht und Datum bleiben erhalten */
const zurueck = (ok: string, anker = '') => {
  const p = new URLSearchParams({ ok });
  for (const k of ['kal', 'datum']) {
    const v = Astro.url.searchParams.get(k);
    if (v) p.set(k, v);
  }
  return Astro.redirect(`/app/verfuegbarkeit?${p}${anker}`);
};

function intervalle(starts: FormDataEntryValue[], enden: FormDataEntryValue[]) {
  const liste: { s: number; e: number }[] = [];
  for (let i = 0; i < starts.length; i++) {
    const s = zeitZuMin(String(starts[i] ?? ''));
    const e = zeitZuMin(String(enden[i] ?? ''));
    if (Number.isNaN(s) && Number.isNaN(e)) continue;
    if (Number.isNaN(s) || Number.isNaN(e) || e <= s) return null;
    liste.push({ s, e });
  }
  liste.sort((a, b) => a.s - b.s);
  for (let i = 1; i < liste.length; i++) if (liste[i].s < liste[i - 1].e) return null;
  return liste;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const aktion = String(form.get('aktion') ?? '');

  if (aktion === 'woche') {
    const zone = String(form.get('zeitzone') ?? '');
    const befehle = [db().prepare('DELETE FROM verfuegbarkeit WHERE nutzer_id = ?').bind(nutzer.id)];
    for (const tag of REIHENFOLGE) {
      if (!form.get(`aktiv_${tag}`)) continue;
      const liste = intervalle(form.getAll(`start_${tag}`), form.getAll(`ende_${tag}`));
      if (!liste) {
        fehler = `${WOCHENTAGE[tag]}: Bitte prüf die Zeiten. Das Ende muss nach dem Beginn liegen und Zeiträume dürfen sich nicht überschneiden.`;
        break;
      }
      for (const iv of liste) {
        befehle.push(db().prepare('INSERT INTO verfuegbarkeit (nutzer_id, wochentag, start_min, ende_min) VALUES (?, ?, ?, ?)').bind(nutzer.id, tag, iv.s, iv.e));
      }
    }
    if (!fehler) {
      if (gueltigeZone(zone)) befehle.push(db().prepare('UPDATE nutzer SET zeitzone = ?, aktualisiert_am = ? WHERE id = ?').bind(zone, jetztIso(), nutzer.id));
      await db().batch(befehle);
      return zurueck('gespeichert');
    }
  }

  if (aktion === 'ausnahme') {
    const datum = String(form.get('datum') ?? '');
    const bisDatum = String(form.get('bis_datum') ?? '') || datum;
    const frei = form.get('art') === 'frei';
    if (!/^\d{4}-\d{2}-\d{2}$/.test(datum) || !/^\d{4}-\d{2}-\d{2}$/.test(bisDatum) || bisDatum < datum) {
      fehler = 'Bitte wähl ein gültiges Datum.';
    } else {
      const liste = frei ? [] : intervalle(form.getAll('a_start'), form.getAll('a_ende'));
      if (!liste || (!frei && liste.length === 0)) fehler = 'Bitte prüf die Zeiten der Ausnahme.';
      else {
        const tage: string[] = [];
        for (let d = new Date(`${datum}T12:00:00Z`); d.toISOString().slice(0, 10) <= bisDatum && tage.length < 62; d.setUTCDate(d.getUTCDate() + 1)) {
          tage.push(d.toISOString().slice(0, 10));
        }
        const befehle = tage.flatMap((t) => [
          db().prepare('DELETE FROM ausnahmen WHERE nutzer_id = ? AND datum = ?').bind(nutzer.id, t),
          ...(frei
            ? [db().prepare('INSERT INTO ausnahmen (nutzer_id, datum, start_min, ende_min) VALUES (?, ?, NULL, NULL)').bind(nutzer.id, t)]
            : liste.map((iv) => db().prepare('INSERT INTO ausnahmen (nutzer_id, datum, start_min, ende_min) VALUES (?, ?, ?, ?)').bind(nutzer.id, t, iv.s, iv.e))),
        ]);
        await db().batch(befehle);
        return zurueck('gespeichert', '#ausnahmen');
      }
    }
  }

  if (aktion === 'ausnahme_loeschen') {
    await ausfuehren('DELETE FROM ausnahmen WHERE nutzer_id = ? AND datum = ?', nutzer.id, String(form.get('datum') ?? ''));
    return zurueck('geloescht', '#ausnahmen');
  }
}

const regeln = await alle<Regel>('SELECT wochentag, start_min, ende_min FROM verfuegbarkeit WHERE nutzer_id = ? ORDER BY start_min', nutzer.id);
const heute = datumInZone(new Date(), nutzer.zeitzone);
const ausnahmen = await alle<Ausnahme>('SELECT * FROM ausnahmen WHERE nutzer_id = ? AND datum >= ? ORDER BY datum, start_min', nutzer.id, heute);
const ausnahmenNachTag = new Map<string, Ausnahme[]>();
for (const a of ausnahmen) ausnahmenNachTag.set(a.datum, [...(ausnahmenNachTag.get(a.datum) ?? []), a]);

const { ansicht, anker } = kalenderParameter(Astro.url, nutzer.zeitzone);
const kalender = await kalenderLaden({ nutzer, ansicht, anker });
const vorbelegt = Astro.url.searchParams.get('ausnahme') ?? '';
const ausnahmeDatum = /^\d{4}-\d{2}-\d{2}$/.test(vorbelegt) && vorbelegt >= heute ? vorbelegt : '';
const tagLink = (datum: string) => {
  const p = new URLSearchParams({ kal: ansicht, datum: anker, ausnahme: datum });
  return `/app/verfuegbarkeit?${p}#ausnahmen`;
};

const zonen = ['Europe/Berlin', 'Europe/Vienna', 'Europe/Zurich', 'Europe/London', 'Europe/Madrid', 'Europe/Istanbul', 'America/New_York', 'Asia/Dubai', 'UTC'];
if (!zonen.includes(nutzer.zeitzone)) zonen.unshift(nutzer.zeitzone);
---
<App titel="Verfügbarkeit" eyebrow="Wann man dich buchen kann" meldung={fehler ? { art: 'fehler', text: fehler } : meldungAusUrl(Astro.url)}>
  <div class="raster">
    <form method="post" class="karte block woche" id="woche">
      <input type="hidden" name="aktion" value="woche" />
      <div class="block-kopf">
        <div class="block-titel">
          <h2>Wochenzeiten</h2>
          <p class="leise klein">Gelten jede Woche, solange kein Tag als Ausnahme eingetragen ist.</p>
        </div>
        <div class="feld zone">
          <label for="zeitzone" class="sr-only">Zeitzone</label>
          <select id="zeitzone" name="zeitzone" class="auswahl">
            {zonen.map((z) => <option value={z} selected={z === nutzer.zeitzone}>{z.replace(/_/g, ' ')}</option>)}
          </select>
        </div>
      </div>
      <ul class="tage" role="list">
        {REIHENFOLGE.map((tag) => {
          const eigene = regeln.filter((r) => r.wochentag === tag);
          return (
            <li class="tag" data-tag={tag}>
              <label class="haken tag-name">
                <input type="checkbox" name={`aktiv_${tag}`} checked={eigene.length > 0} />
                <span>{WOCHENTAGE[tag]}</span>
              </label>
              <div class="intervalle">
                {(eigene.length ? eigene : [{ start_min: 540, ende_min: 1020 }]).map((r) => (
                  <div class="intervall">
                    <input type="time" class="eingabe" name={`start_${tag}`} value={minZuZeit(r.start_min)} aria-label={`${WOCHENTAGE[tag]} von`} step="300" />
                    <span aria-hidden="true">bis</span>
                    <input type="time" class="eingabe" name={`ende_${tag}`} value={minZuZeit(r.ende_min)} aria-label={`${WOCHENTAGE[tag]} bis`} step="300" />
                    <button type="button" class="symbol weg" aria-label="Zeitraum entfernen" title="Zeitraum entfernen"><Icon name="x" /></button>
                  </div>
                ))}
                <p class="nicht leise klein">Nicht verfügbar</p>
              </div>
              <div class="tag-aktionen">
                <button type="button" class="symbol plus" aria-label={`Zeitraum am ${WOCHENTAGE[tag]} hinzufügen`} title="Zeitraum hinzufügen"><Icon name="plus" /></button>
                <button type="button" class="symbol kopie" aria-label={`Zeiten vom ${WOCHENTAGE[tag]} auf alle aktiven Tage übertragen`} title="Auf alle aktiven Tage übertragen"><Icon name="kopieren" /></button>
              </div>
            </li>
          );
        })}
      </ul>
      <div class="block-fuss">
        <button type="submit" class="knopf knopf--orange">Wochenzeiten speichern</button>
        <p class="ungespeichert klein" hidden role="status">Ungespeicherte Änderungen</p>
      </div>
    </form>

    <div class="kal-bereich">
      <Kalender daten={kalender} tagLink={tagLink} tagLinkLabel="Ausnahme für diesen Tag eintragen" vorschau />
    </div>

    <section class="karte block ausnahmen-block" id="ausnahmen" aria-labelledby="a-titel">
      <div class="block-titel">
        <h2 id="a-titel">Ausnahmen</h2>
        <p class="leise klein">Urlaub, Feiertage oder abweichende Zeiten an einzelnen Tagen. Ausnahmen ersetzen die Wochenzeiten für diesen Tag. Tipp: Klick im Kalender auf einen Tag, dann ist das Datum schon eingetragen.</p>
      </div>
      <div class="ausnahmen-raster">
        <form method="post" class="ausnahme-form">
          <input type="hidden" name="aktion" value="ausnahme" />
          <div class="zwei">
            <div class="feld">
              <label for="datum">Datum</label>
              <input id="datum" name="datum" type="date" class="eingabe" min={heute} value={ausnahmeDatum} required autofocus={Boolean(ausnahmeDatum)} />
            </div>
            <div class="feld">
              <label for="bis_datum">Bis<span class="leise"> (optional)</span></label>
              <input id="bis_datum" name="bis_datum" type="date" class="eingabe" min={heute} />
            </div>
          </div>
          <fieldset class="art">
            <legend class="sr-only">Art der Ausnahme</legend>
            <label class="haken"><input type="radio" name="art" value="frei" checked />Ganzer Tag nicht verfügbar</label>
            <label class="haken"><input type="radio" name="art" value="zeiten" />Andere Zeiten</label>
          </fieldset>
          <div class="intervall a-zeiten">
            <input type="time" class="eingabe" name="a_start" value="10:00" aria-label="Von" step="300" />
            <span aria-hidden="true">bis</span>
            <input type="time" class="eingabe" name="a_ende" value="14:00" aria-label="Bis" step="300" />
          </div>
          <button type="submit" class="knopf knopf--rahmen"><Icon name="plus" />Ausnahme hinzufügen</button>
        </form>

        <div class="geplant">
          <h3 class="geplant-titel">Geplante Ausnahmen</h3>
          {ausnahmenNachTag.size > 0 ? (
            <ul class="ausnahmen" role="list">
              {[...ausnahmenNachTag.entries()].map(([datum, liste]) => (
                <li>
                  <span>
                    <strong>{formatDatumLang(`${datum}T12:00:00Z`, 'UTC')}</strong><br />
                    <span class="leise klein">{liste[0].start_min === null ? 'Nicht verfügbar' : liste.map((a) => `${minZuZeit(a.start_min!)} bis ${minZuZeit(a.ende_min!)}`).join(', ')}</span>
                  </span>
                  <form method="post">
                    <input type="hidden" name="aktion" value="ausnahme_loeschen" />
                    <input type="hidden" name="datum" value={datum} />
                    <button class="symbol" type="submit" aria-label={`Ausnahme am ${datum} löschen`} title="Ausnahme löschen"><Icon name="loeschen" /></button>
                  </form>
                </li>
              ))}
            </ul>
          ) : (
            <p class="leer leise klein">Noch keine Ausnahmen geplant.</p>
          )}
        </div>
      </div>
    </section>
  </div>
</App>

<script>
  const woche = document.getElementById('woche')!;
  const aktualisieren = (li: HTMLElement) => {
    const an = li.querySelector<HTMLInputElement>('.tag-name input')!.checked;
    li.classList.toggle('aus', !an);
    li.querySelectorAll<HTMLInputElement>('.intervall input').forEach((i) => (i.disabled = !an));
  };
  woche.querySelectorAll<HTMLElement>('.tag').forEach((li) => {
    aktualisieren(li);
    li.querySelector('.tag-name input')!.addEventListener('change', () => aktualisieren(li));
  });
  woche.addEventListener('click', (e) => {
    const ziel = e.target as HTMLElement;
    const li = ziel.closest<HTMLElement>('.tag');
    if (!li) return;
    const box = li.querySelector('.intervalle')!;
    if (ziel.closest('.plus')) {
      const check = li.querySelector<HTMLInputElement>('.tag-name input')!;
      if (!check.checked) { check.checked = true; aktualisieren(li); vorschau(); return; }
      const letztes = box.querySelectorAll('.intervall');
      const neu = letztes[letztes.length - 1].cloneNode(true) as HTMLElement;
      const [s, en] = neu.querySelectorAll<HTMLInputElement>('input');
      const altEnde = (letztes[letztes.length - 1].querySelectorAll<HTMLInputElement>('input')[1].value || '17:00').split(':').map(Number);
      const startMin = Math.min(altEnde[0] * 60 + altEnde[1] + 60, 22 * 60);
      const z = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
      s.value = z(startMin);
      en.value = z(Math.min(startMin + 120, 23 * 60 + 55));
      letztes[letztes.length - 1].after(neu);
      s.focus();
    }
    if (ziel.closest('.weg')) {
      const alle = box.querySelectorAll('.intervall');
      if (alle.length > 1) ziel.closest('.intervall')!.remove();
      else { li.querySelector<HTMLInputElement>('.tag-name input')!.checked = false; aktualisieren(li); }
    }
    if (ziel.closest('.kopie')) {
      const vorlage = [...box.querySelectorAll('.intervall')].map((iv) => [...iv.querySelectorAll<HTMLInputElement>('input')].map((i) => i.value));
      woche.querySelectorAll<HTMLElement>('.tag').forEach((andere) => {
        if (andere === li || !andere.querySelector<HTMLInputElement>('.tag-name input')!.checked) return;
        const ziel2 = andere.querySelector('.intervalle')!;
        const muster = ziel2.querySelector('.intervall')!;
        ziel2.querySelectorAll('.intervall').forEach((iv) => iv.remove());
        const tag = andere.dataset.tag;
        vorlage.reverse().forEach(([s, en]) => {
          const neu = muster.cloneNode(true) as HTMLElement;
          const [a, b] = neu.querySelectorAll<HTMLInputElement>('input');
          a.value = s; b.value = en; a.name = `start_${tag}`; b.name = `ende_${tag}`;
          ziel2.prepend(neu);
        });
        vorlage.reverse();
      });
    }
    if (ziel.closest('.plus, .weg, .kopie')) vorschau();
  });

  // Live Vorschau: Wochenzeiten sofort im Kalender zeigen, bevor gespeichert wird
  const kw = document.querySelector<HTMLElement>('.kw');
  const hinweisKal = document.querySelector<HTMLElement>('.kal-vorschau');
  const hinweisForm = woche.querySelector<HTMLElement>('.ungespeichert');
  const minuten = (wert: string) => {
    const [h, m] = wert.split(':').map(Number);
    return Number.isFinite(h) && Number.isFinite(m) ? h * 60 + m : NaN;
  };
  function vorschau() {
    if (hinweisForm) hinweisForm.hidden = false;
    if (!kw) return;
    if (hinweisKal) hinweisKal.hidden = false;
    const vonMin = Number(kw.dataset.vonMin);
    const bisMin = Number(kw.dataset.bisMin);
    woche.querySelectorAll<HTMLElement>('.tag').forEach((li) => {
      const an = li.querySelector<HTMLInputElement>('.tag-name input')!.checked;
      const spannen = an
        ? [...li.querySelectorAll('.intervall')].map((iv) => {
            const [s, e] = [...iv.querySelectorAll<HTMLInputElement>('input')].map((i) => minuten(i.value));
            return { s: Math.max(s, vonMin), e: Math.min(e, bisMin) };
          }).filter((x) => x.e > x.s)
        : [];
      kw.querySelectorAll<HTMLElement>(`.kw-spalte[data-wochentag="${li.dataset.tag}"][data-ausnahme="0"]`).forEach((spalte) => {
        spalte.querySelectorAll('.kw-frei').forEach((f) => f.remove());
        spannen.forEach(({ s, e }) => {
          const block = document.createElement('div');
          block.className = 'kw-frei';
          block.style.setProperty('--a', String(s));
          block.style.setProperty('--d', String(e - s));
          spalte.prepend(block);
        });
      });
    });
  }
  woche.addEventListener('input', vorschau);
  woche.addEventListener('change', vorschau);

  // Ausnahmen: Zeitfelder nur bei „Andere Zeiten“
  const aForm = document.querySelector<HTMLFormElement>('.ausnahme-form')!;
  const aZeiten = aForm.querySelector<HTMLElement>('.a-zeiten')!;
  const art = () => {
    const zeiten = aForm.querySelector<HTMLInputElement>('input[name="art"]:checked')?.value === 'zeiten';
    aZeiten.hidden = !zeiten;
  };
  aForm.querySelectorAll('input[name="art"]').forEach((r) => r.addEventListener('change', art));
  art();
</script>

<style>
  .raster {
    display: grid; gap: var(--raum-6); align-items: start;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'kal' 'woche' 'aus';
  }
  .woche { grid-area: woche; }
  .kal-bereich { grid-area: kal; min-width: 0; }
  .ausnahmen-block { grid-area: aus; }
  @media (min-width: 1380px) {
    .raster { grid-template-columns: minmax(0, 640px) minmax(0, 1fr); grid-template-areas: 'kal kal' 'woche aus'; }
  }
  @media (min-width: 1800px) {
    .raster { grid-template-columns: 640px minmax(0, 1fr); grid-template-areas: 'woche kal' 'woche aus'; }
    .woche { position: sticky; top: var(--raum-6); }
  }
  .block { padding: var(--raum-6); display: grid; gap: var(--raum-4); min-width: 0; }
  .block h2 { font-family: var(--schrift-text); font-weight: 600; font-size: var(--text-h4); letter-spacing: 0; }
  .block-titel { display: grid; gap: var(--raum-1); }
  .block-kopf { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--raum-4); flex-wrap: wrap; }
  .block-kopf .block-titel { flex: 1 1 220px; }
  .zone { min-width: 200px; }
  .tage { list-style: none; margin: 0; padding: 0; }
  .tag { display: grid; grid-template-columns: 140px minmax(0, 1fr) auto; gap: var(--raum-4); align-items: start; padding: var(--raum-3) 0; border-top: 1px solid var(--farbe-rahmen); }
  .tag-name { min-height: 44px; align-items: center; font-weight: 600; }
  .intervalle { display: grid; gap: var(--raum-2); }
  .intervall { display: flex; align-items: center; gap: var(--raum-2); }
  .intervall .eingabe { width: 8.5rem; }
  .nicht { display: none; min-height: 44px; align-items: center; }
  .tag.aus .intervall { display: none; }
  .tag.aus .nicht { display: flex; }
  .tag-aktionen { display: flex; gap: 2px; padding-left: var(--raum-2); border-left: 1px solid var(--farbe-rahmen); }
  .tag.aus .kopie { visibility: hidden; }
  .symbol {
    display: grid; place-items: center; width: 40px; height: 40px; background: none; border: 1px solid transparent; cursor: pointer; color: var(--n-700); border-radius: var(--radius-s); flex: none;
  }
  .symbol:hover { border-color: var(--n-900); color: var(--n-900); }
  .block-fuss { display: flex; align-items: center; gap: var(--raum-4); flex-wrap: wrap; padding-top: var(--raum-4); border-top: 1px solid var(--farbe-rahmen); }
  .ungespeichert { display: inline-flex; align-items: center; gap: var(--raum-2); font-weight: 600; }
  .ungespeichert::before { content: ''; width: 8px; height: 8px; background: var(--farbe-akzent); }

  .ausnahmen-block { container-type: inline-size; }
  .ausnahmen-raster { display: grid; gap: var(--raum-6); }
  @container (min-width: 760px) {
    .ausnahmen-raster { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }
  .ausnahme-form { display: grid; gap: var(--raum-4); justify-items: start; padding: var(--raum-4); background: var(--n-050); border: 1px solid var(--farbe-rahmen); }
  .zwei { display: grid; grid-template-columns: 1fr 1fr; gap: var(--raum-4); width: 100%; }
  .art { border: 0; padding: 0; margin: 0; display: grid; gap: var(--raum-2); }
  .geplant { display: grid; gap: var(--raum-2); align-content: start; }
  .geplant-titel { font-size: var(--text-sm); font-weight: 600; }
  .ausnahmen { list-style: none; margin: 0; padding: 0; }
  .ausnahmen li { display: flex; justify-content: space-between; align-items: center; gap: var(--raum-4); padding: var(--raum-3) 0; border-top: 1px solid var(--farbe-rahmen); }
  .leer { padding: var(--raum-4); border: 1px dashed var(--farbe-rahmen-stark); }
  @media (max-width: 640px) {
    .tag { grid-template-columns: minmax(0, 1fr) auto; }
    .block { padding: var(--raum-4); }
    .intervalle { grid-column: 1 / -1; grid-row: 2; }
    .intervall .eingabe { width: 0; flex: 1 1 0; min-width: 0; }
    .zwei { grid-template-columns: 1fr; }
  }
</style>
