---
import App from '../../../layouts/App.astro';
import Icon from '../../../components/ui/Icon.astro';
import OrtIcon from '../../../components/OrtIcon.astro';
import { terminartenVon } from '../../../lib/abfragen';
import { alle, ausfuehren, db, eins, jetztIso, neueId } from '../../../lib/db';
import { meldungAusUrl } from '../../../lib/meldungen';
import { ORT_LABEL, type Terminart } from '../../../lib/typen';

const nutzer = Astro.locals.gastgeber!;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id') ?? '');
  const aktion = String(form.get('aktion') ?? '');
  const ta = await eins<Terminart>('SELECT * FROM terminarten WHERE id = ? AND nutzer_id = ?', id, nutzer.id);
  if (ta) {
    if (aktion === 'umschalten') {
      await ausfuehren('UPDATE terminarten SET aktiv = ?, aktualisiert_am = ? WHERE id = ?', ta.aktiv ? 0 : 1, jetztIso(), id);
      return Astro.redirect('/app/terminarten?ok=gespeichert');
    }
    if (aktion === 'duplizieren') {
      const slugs = new Set((await alle<{ slug: string }>('SELECT slug FROM terminarten WHERE nutzer_id = ?', nutzer.id)).map((s) => s.slug));
      let slug = `${ta.slug}-kopie`;
      for (let i = 2; slugs.has(slug); i++) slug = `${ta.slug}-kopie-${i}`;
      const jetzt = jetztIso();
      await db()
        .prepare(
          `INSERT INTO terminarten (id, nutzer_id, slug, titel, beschreibung, dauer_min, farbe, ort_typ, ort_wert, puffer_vor_min, puffer_nach_min,
            vorlauf_min, max_tage_voraus, raster_min, max_pro_tag, fragen, unterlagen, erinnerung_std, erinnerungen, bestaetigung_text, weiterleitung_url, aktiv, geheim, reihenfolge, erstellt_am, aktualisiert_am)
           SELECT ?, nutzer_id, ?, titel || ' (Kopie)', beschreibung, dauer_min, farbe, ort_typ, ort_wert, puffer_vor_min, puffer_nach_min,
            vorlauf_min, max_tage_voraus, raster_min, max_pro_tag, fragen, unterlagen, erinnerung_std, erinnerungen, bestaetigung_text, weiterleitung_url, 0, geheim, reihenfolge + 1, ?, ?
           FROM terminarten WHERE id = ?`,
        )
        .bind(neueId(), slug, jetzt, jetzt, id)
        .run();
      return Astro.redirect('/app/terminarten?ok=dupliziert');
    }
  }
  return Astro.redirect('/app/terminarten');
}

const arten = await terminartenVon(nutzer.id);
const basis = Astro.url.origin;
const kurztext = (t: string | null) => (t ?? '').replace(/\s+/g, ' ').trim();
// Aktive oben, ausgeschaltete automatisch darunter in einem eigenen Abschnitt
const gruppen = [
  { id: 'aktiv', titel: 'Aktiv', hilfe: 'Buchbar über ihren Link.', liste: arten.filter((t) => t.aktiv) },
  { id: 'inaktiv', titel: 'Nicht aktiv', hilfe: 'Ausgeschaltet, niemand kann sie buchen. Mit dem Schalter wieder aktivieren.', liste: arten.filter((t) => !t.aktiv) },
].filter((g) => g.liste.length > 0);
---
<App titel="Terminarten" eyebrow={`${basis.replace(/^https?:\/\//, '')}`} meldung={meldungAusUrl(Astro.url)}>
  <Fragment slot="aktionen">
    <button type="button" class="knopf knopf--rahmen" data-kopieren={`${basis}/`}><Icon name="link" />Buchungslink kopieren</button>
    <a class="knopf knopf--orange" href="/app/terminarten/neu"><Icon name="plus" />Neue Terminart</a>
  </Fragment>

  {arten.length === 0 ? (
    <div class="leer karte">
      <h2>Noch keine Terminart<span class="punkt">.</span></h2>
      <p class="leise">Leg fest, welche Gespräche man bei dir buchen kann, zum Beispiel ein Erstgespräch über 30 Minuten.</p>
      <a class="knopf knopf--orange" href="/app/terminarten/neu"><Icon name="plus" />Erste Terminart anlegen</a>
    </div>
  ) : (
    <div class="gruppen">
    {gruppen.map((g) => (
    <section class:list={['gruppe', `gruppe--${g.id}`]} aria-labelledby={`gruppe-${g.id}`}>
      <header class="gruppe-kopf">
        <h2 id={`gruppe-${g.id}`}>{g.titel}<span class="anzahl">{g.liste.length}</span></h2>
        <p class="leise klein">{g.hilfe}</p>
      </header>
    <ul class="raster" role="list">
      {g.liste.map((ta) => (
        <li class:list={['art', 'karte', { inaktiv: !ta.aktiv }]} style={`--farbe:${ta.farbe}`}>
          <div class="art-kopf">
            <form method="post">
              <input type="hidden" name="id" value={ta.id} />
              <input type="hidden" name="aktion" value="umschalten" />
              <label class="schalter">
                <input type="checkbox" checked={Boolean(ta.aktiv)} onchange="this.form.requestSubmit()" aria-label={`${ta.titel} ${ta.aktiv ? 'deaktivieren' : 'aktivieren'}`} />
                <span class="leise">{ta.aktiv ? 'Aktiv' : 'Aus'}</span>
              </label>
              <noscript><button class="knopf knopf--klein knopf--leise">Umschalten</button></noscript>
            </form>
            {ta.geheim ? <span class="badge badge--hell">Geheim</span> : null}
          </div>
          <a class="art-titel" href={`/app/terminarten/${ta.id}`}>{ta.titel}</a>
          <p class="art-meta">
            <span><Icon name="uhr" groesse={16} />{ta.dauer_min} Min</span>
            <span><OrtIcon typ={ta.ort_typ} groesse={16} />{ORT_LABEL[ta.ort_typ]}</span>
          </p>
          {kurztext(ta.beschreibung) ? <p class="art-text">{kurztext(ta.beschreibung)}</p> : null}
          <a class="art-link leise klein" href={`/${ta.slug}`} target="_blank" rel="noopener">/{ta.slug}</a>
          <div class="art-fuss">
            <button type="button" class="knopf knopf--rahmen knopf--klein" data-kopieren={`${basis}/${ta.slug}`}><Icon name="kopieren" />Link kopieren</button>
            <div class="art-mehr">
              <a class="symbol" href={`/app/terminarten/${ta.id}`} title="Bearbeiten"><Icon name="stift" /><span class="sr-only">{ta.titel} bearbeiten</span></a>
              <form method="post">
                <input type="hidden" name="id" value={ta.id} />
                <button class="symbol" name="aktion" value="duplizieren" title="Duplizieren"><Icon name="kopieren" /><span class="sr-only">{ta.titel} duplizieren</span></button>
              </form>
            </div>
          </div>
        </li>
      ))}
    </ul>
    </section>
    ))}
    </div>
  )}
</App>

<style>
  .leer { padding: var(--raum-12); display: grid; gap: var(--raum-4); justify-items: start; }
  .gruppen { display: grid; gap: var(--raum-8); }
  .gruppe { display: grid; gap: var(--raum-4); }
  .gruppe--inaktiv { padding-top: var(--raum-8); border-top: 1px solid var(--farbe-rahmen); }
  .gruppe-kopf { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--raum-2) var(--raum-4); }
  .gruppe-kopf h2 { display: inline-flex; align-items: center; gap: var(--raum-3); font-family: var(--schrift-text); font-weight: 600; font-size: var(--text-h4); letter-spacing: 0; }
  .anzahl { display: inline-grid; place-items: center; min-width: 26px; height: 26px; padding: 0 8px; background: var(--n-100); font-size: var(--text-sm); font-weight: 600; border-radius: 999px; }
  .gruppe--aktiv .anzahl { background: var(--n-900); color: var(--farbe-papier); }
  .raster { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: var(--raum-4); }
  @media (min-width: 700px) { .raster { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .raster { grid-template-columns: repeat(4, 1fr); } }
  .art { display: flex; flex-direction: column; gap: var(--raum-3); padding: var(--raum-6); border-top: 4px solid var(--farbe); }
  .art.inaktiv { opacity: 0.6; border-top-color: var(--n-300); }
  .art-kopf { display: flex; justify-content: space-between; align-items: center; gap: var(--raum-2); }
  .art-titel { font-family: var(--schrift-display); font-weight: 900; font-size: var(--text-h3); line-height: 1.05; text-decoration: none; }
  .art-titel:hover { text-decoration: underline; text-decoration-color: var(--farbe-akzent); }
  .art-meta { display: flex; flex-wrap: wrap; gap: var(--raum-2) var(--raum-4); font-size: var(--text-sm); color: var(--farbe-text-2); }
  .art-meta span { display: inline-flex; align-items: center; gap: 6px; }
  .art-text { margin: 0; font-size: var(--text-sm); line-height: 1.5; color: var(--farbe-text-2); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .art-link { overflow-wrap: anywhere; }
  .art-fuss { margin-top: auto; padding-top: var(--raum-4); border-top: 1px solid var(--farbe-rahmen); display: flex; justify-content: space-between; align-items: center; gap: var(--raum-2); }
  .art-mehr { display: flex; gap: 2px; }
  .symbol {
    display: grid; place-items: center; width: 36px; height: 36px; background: none; border: 1px solid transparent;
    color: var(--n-700); cursor: pointer; border-radius: var(--radius-s);
  }
  .symbol:hover { border-color: var(--n-900); color: var(--n-900); }
  .symbol.gefahr:hover { border-color: var(--farbe-fehler); color: var(--farbe-fehler); }
</style>
