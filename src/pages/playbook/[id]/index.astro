---
/**
 * Persönliche Playbook Seite. Erreichbar nur über den Link aus der Mail der Landingpage.
 * Gültig: Flipbook, PDF Download, Knopf zum passenden Gespräch. Abgelaufen oder gesperrt:
 * Hinweis mit Weg zurück zur Landingpage, dort lässt sich das Playbook neu anfordern.
 */
import Oeffentlich from '../../../layouts/Oeffentlich.astro';
import PlaybookFlipbook from '../../../components/PlaybookFlipbook.astro';
import Icon from '../../../components/ui/Icon.astro';
import { gespraechLink, istPlaybook, PLAYBOOKS, playbookDateien, zugangLesen, zugangStatus } from '../../../lib/playbooks';
import { formatDatumMittel } from '../../../lib/zeit';

const zugang = await zugangLesen(Astro.params.id ?? '');
if (!zugang || !istPlaybook(zugang.playbook)) return Astro.rewrite('/404');

const pb = PLAYBOOKS[zugang.playbook];
const dateien = playbookDateien(zugang.playbook);
const status = zugangStatus(zugang);
const vorname = zugang.name.split(/\s+/)[0] ?? zugang.name;
const bis = formatDatumMittel(zugang.gueltig_bis, 'Europe/Berlin');
const mb = dateien?.pdfBytes ? (dateien.pdfBytes / 1_048_576).toLocaleString('de-DE', { maximumFractionDigits: 1 }) : null;
---
<Oeffentlich titel={status === 'gueltig' ? pb.name : 'Link nicht mehr gültig'} breit>
  {status === 'gueltig' ? (
    <article class="playbook">
      <header class="kopf-text">
        <p class="eyebrow">Dein Playbook</p>
        <h1>{pb.name}<span class="punkt">.</span></h1>
        <p class="einleitung">
          Hallo {vorname}, hier kannst du das Playbook direkt durchblättern oder als PDF speichern.
          Dein persönlicher Link gilt bis zum {bis}.
        </p>
      </header>

      {dateien && dateien.seiten > 0 && (
        <PlaybookFlipbook id={zugang.id} name={pb.name} seiten={dateien.seiten} breite={dateien.breite} hoehe={dateien.hoehe} />
      )}

      <div class="aktionen">
        {mb ? (
          <a class="knopf knopf--orange" href={`/playbook/${zugang.id}/pdf`} download>
            <Icon name="download" />Als PDF herunterladen <span class="groesse">({mb} MB)</span>
          </a>
        ) : (
          <p class="leise">Die PDF wird gerade vorbereitet. Schau in ein paar Stunden noch einmal hier vorbei.</p>
        )}
      </div>

      <section class="gespraech karte" aria-labelledby="gespraech-titel">
        <div>
          <p class="eyebrow">Nächster Schritt</p>
          <h2 id="gespraech-titel">Lieber gemeinsam umsetzen?</h2>
          <p>Im kostenlosen {pb.gespraechName} schauen wir uns deine Situation an und zeigen dir, wo du anfängst. 60 Minuten, unverbindlich, per Videocall.</p>
        </div>
        <a class="knopf" href={gespraechLink(zugang)}><Icon name="kalender" />Kostenloses Strategiegespräch buchen</a>
      </section>
    </article>
  ) : (
    <article class="abgelaufen karte">
      <p class="eyebrow">{pb.name}</p>
      <h1>Dieser Link ist nicht mehr gültig<span class="punkt">.</span></h1>
      <p>
        {status === 'abgelaufen'
          ? `Dein persönlicher Link war bis zum ${bis} gültig. Fordere das Playbook einfach neu an, du bekommst sofort einen neuen Link per Mail.`
          : 'Fordere das Playbook einfach neu an, du bekommst sofort einen neuen Link per Mail.'}
      </p>
      <a class="knopf knopf--orange" href={pb.landingpage}>Playbook neu anfordern</a>
      <p class="leise klein">Fragen? Schreib uns an <a href="mailto:info@thatsit.marketing">info@thatsit.marketing</a>.</p>
    </article>
  )}
</Oeffentlich>

{status === 'gueltig' && (
  <script is:inline define:vars={{ adresse: `/playbook/${zugang.id}/gesehen` }}>
    // Öffnen erst melden, wenn die Seite wirklich angezeigt wird (Linkprüfungen der Mailprogramme zählen so nicht)
    let gemeldet = false;
    const melden = () => {
      if (gemeldet || document.visibilityState !== 'visible') return;
      gemeldet = true;
      fetch(adresse, { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}', keepalive: true }).catch(() => {});
    };
    setTimeout(melden, 1500);
    document.addEventListener('visibilitychange', () => setTimeout(melden, 1500));
  </script>
)}

<style>
  h1, h2 { hyphens: manual; overflow-wrap: break-word; }
  .playbook { max-width: 1240px; margin: 0 auto; display: grid; gap: var(--raum-8); }
  .kopf-text { display: grid; gap: var(--raum-3); max-width: 760px; }
  .einleitung { color: var(--farbe-text-2); font-size: var(--text-lg); }
  .aktionen { display: flex; justify-content: center; }
  .aktionen .knopf { font-family: var(--schrift-text); font-weight: 600; letter-spacing: 0; text-transform: none; font-size: var(--text-base); min-height: 52px; padding-inline: 1.75rem; }
  .groesse { font-weight: 400; }
  .gespraech { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--raum-6); padding: clamp(1.5rem, 4vw, 2.5rem); }
  .gespraech > div { display: grid; gap: var(--raum-3); }
  .gespraech p:not(.eyebrow) { color: var(--farbe-text-2); max-width: 62ch; }
  .gespraech .knopf { font-family: var(--schrift-text); font-weight: 600; letter-spacing: 0; text-transform: none; font-size: var(--text-base); }
  .abgelaufen { max-width: 640px; margin: 0 auto; padding: clamp(1.5rem, 5vw, 3rem); display: grid; gap: var(--raum-4); justify-items: start; }
  @media (max-width: 760px) {
    .gespraech { grid-template-columns: 1fr; }
    .gespraech .knopf, .aktionen .knopf { width: 100%; white-space: normal; text-align: center; }
  }
</style>
