---
/*
 * /{terminart}: Buchung einer Terminart des Büros.
 * Alte Profillinks einzelner Teammitglieder (/{nutzer}) leiten auf die zentrale Seite weiter.
 */
import Oeffentlich from '../layouts/Oeffentlich.astro';
import BuchungsSeite from '../components/BuchungsSeite.astro';
import { buero, nutzerNachSlug, terminartNachSlug, terminartenVon } from '../lib/abfragen';

const slug = (Astro.params.slug ?? '').toLowerCase();
const gastgeber = await buero();
if (!gastgeber) return Astro.rewrite('/404');

const terminart = await terminartNachSlug(gastgeber.id, slug);
if (!terminart || !terminart.aktiv) {
  if (await nutzerNachSlug(slug)) return Astro.redirect(`/${Astro.url.search}`, 301);
  return Astro.rewrite('/404');
}
const arten = await terminartenVon(gastgeber.id, true);
---
<Oeffentlich
  titel={`${terminart.titel} | That's it. Marketing`}
  beschreibung={`Buche ${terminart.titel} (${terminart.dauer_min} Minuten) mit That's it. Marketing aus Gelsenkirchen direkt online.`}
  indexieren={!terminart.geheim}
  bild
>
  <BuchungsSeite gastgeber={gastgeber} terminart={terminart} arten={terminart.geheim ? [] : arten} />
</Oeffentlich>
