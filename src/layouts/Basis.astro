---
import '../styles/global.css';

interface Props {
  titel: string;
  beschreibung?: string;
  indexieren?: boolean;
  klasse?: string;
  /** thatsit: Seiten ohne Let's Meet Bezug (Playbook Seite), Titel und Seitenname nur mit That's it. Marketing */
  marke?: 'letsmeet' | 'thatsit';
}

const { titel, beschreibung = "Termin mit That's it. Marketing buchen. Direkt online, ohne Hin und Her per Mail.", indexieren = false, klasse, marke = 'letsmeet' } = Astro.props;
const zusatz = marke === 'thatsit' ? "That's it. Marketing" : "Let's Meet";
const voll = titel.includes(zusatz) ? titel : `${titel} | ${zusatz}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{voll}</title>
    <meta name="description" content={beschreibung} />
    <meta name="robots" content={indexieren ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#0E0E0E" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/league-spartan-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={voll} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={marke === 'thatsit' ? "That's it. Marketing" : "Let's Meet by That's it. Marketing"} />
    <slot name="head" />
  </head>
  <body class={klasse}>
    <slot />
  </body>
</html>
