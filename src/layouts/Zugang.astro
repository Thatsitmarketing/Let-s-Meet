---
import Basis from './Basis.astro';
import Logo from '../components/ui/Logo.astro';
interface Props { titel: string }
const { titel } = Astro.props;
---
<Basis titel={`${titel} | Let's Meet`} klasse="zugang">
  <div class="zugang-rahmen">
    <section class="buehne dunkel" aria-hidden="true">
      <Logo variante="weiss" hoehe={120} klasse="buehne-logo" />
      <p class="eyebrow">Terminbuchung</p>
    </section>
    <main class="formularseite" id="inhalt">
      <div class="formularbox">
        <slot />
      </div>
    </main>
  </div>
</Basis>
<style>
  .zugang-rahmen { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 100vh; }
  .buehne {
    background: var(--n-900); color: var(--farbe-papier); padding: clamp(2rem, 5vw, 4rem);
    display: flex; flex-direction: column; justify-content: space-between; gap: var(--raum-12);
  }
  .buehne :global(.buehne-logo) { width: min(100%, 560px); margin-top: auto; }
  .formularseite { display: grid; place-items: center; padding: clamp(1.5rem, 5vw, 4rem); background: var(--farbe-papier); }
  .formularbox { width: 100%; max-width: 420px; display: grid; gap: var(--raum-6); }
  @media (max-width: 820px) {
    .zugang-rahmen { grid-template-columns: 1fr; min-height: auto; }
    .buehne { gap: var(--raum-6); }
    .buehne :global(.buehne-logo) { width: min(100%, 320px); }
  }
</style>
