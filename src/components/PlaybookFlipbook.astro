    };
    if ('ResizeObserver' in window) new ResizeObserver((e) => pruefeModus(e[0]?.contentRect.width ?? buehne.clientWidth)).observe(buehne);
    pruefeModus(buehne.clientWidth);
    zeichne();

    /* Vollbild, wo der Browser es kann (nicht auf dem iPhone) */
    if (vollbild && document.fullscreenEnabled) {
