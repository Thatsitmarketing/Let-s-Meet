---
/** Logos der eingesetzten Dienste (vereinfachte Marken), jeweils in einer quadratischen Kachel. Alt Text und Titel über `name`. */
interface Props { marke: 'google' | 'resend' | 'cloudflare' | 'github' | 'close' | 'thatsit' | 'kalender'; name: string; groesse?: number }
const { marke, name, groesse = 40 } = Astro.props;
---
<span class="marke" style={`--g:${groesse}px`} role="img" aria-label={name} title={name}>
  {marke === 'google' && (
    <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
  )}
  {marke === 'kalender' && (
    <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="6" width="36" height="36" rx="4" fill="#fff" stroke="#DADCE0" stroke-width="2"/><path fill="#4285F4" d="M6 10a4 4 0 0 1 4-4h28a4 4 0 0 1 4 4v6H6z"/><path fill="#34A853" d="M42 32v6a4 4 0 0 1-4 4h-6v-10z"/><path fill="#FBBC05" d="M6 32h10v10h-6a4 4 0 0 1-4-4z"/><path fill="#EA4335" d="M32 42v-10h10z"/><text x="24" y="33" text-anchor="middle" font-family="Montserrat, sans-serif" font-weight="700" font-size="15" fill="#4285F4">31</text></svg>
  )}
  {marke === 'resend' && (
    <svg viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="8" fill="#000"/><path fill="#fff" d="M17 11h10.5c4.4 0 7.5 2.6 7.5 6.6 0 3-1.8 5.2-4.6 6.2l5.6 9.2h-5.3l-5-8.4H21.5V33H17zm4.5 4v6.3h5.7c2.2 0 3.4-1.2 3.4-3.1s-1.2-3.2-3.4-3.2z"/></svg>
  )}
  {marke === 'cloudflare' && (
    <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#F6821F" d="M33.6 31.5l.5-1.7c.2-.7.1-1.3-.2-1.7-.3-.4-.8-.6-1.4-.7l-11.9-.2c-.1 0-.2-.1-.3-.1 0-.1 0-.2.1-.3.1-.2.2-.3.4-.3l12-.2c1.4-.1 3-1.2 3.5-2.6l.7-1.8c0-.1.1-.2 0-.3-.8-3.8-4.2-6.6-8.2-6.6-3.7 0-6.8 2.4-7.9 5.7-.7-.5-1.6-.8-2.6-.7-1.8.2-3.2 1.6-3.4 3.4 0 .5 0 .9.1 1.3-2.9.1-5.200 2.5-5.200 5.400 0 .3 0 .5.1.8 0 .1.1.2.3.2h21.600c.2 0 .4-.1.4-.3z"/><path fill="#FAAE40" d="M37.800 24.800c-.1 0-.3 0-.4 0-.1 0-.2.1-.3.200l-.5 1.700c-.2.700-.1 1.300.2 1.700.3.400.8.600 1.400.700l2.500.2c.1 0 .2.100.3.100 0 .1 0 .2-.1.300-.1.200-.2.300-.4.300l-2.600.2c-1.400.1-3 1.200-3.500 2.600l-.2.600c0 .1 0 .2.200.2h8.900c.1 0 .2-.1.200-.2.200-.7.300-1.400.3-2.100 0-4.100-3.300-7.400-7.400-7.400"/></svg>
  )}
  {marke === 'github' && (
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" rx="3" fill="#0E0E0E"/><g transform="translate(2.4 2.4) scale(0.7)"><path fill="#fff" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></g></svg>
  )}
  {marke === 'close' && (
    <svg viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="8" fill="#2F6BFF"/><path fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" d="M31 17a10 10 0 1 0 0 14"/></svg>
  )}
  {marke === 'thatsit' && <img src="/images/brand/logo-schwarz.webp" alt="" width="64" height="20" class="logo" />}
</span>
<style>
  .marke { flex: none; width: var(--g); height: var(--g); display: inline-grid; place-items: center; background: var(--n-050, #f6f6f6); border: 1px solid var(--farbe-rahmen); border-radius: 2px; padding: calc(var(--g) * 0.2); box-sizing: border-box; }
  .marke svg { width: 100%; height: 100%; display: block; }
  .marke :global(.logo) { width: 100%; height: auto; }
</style>
