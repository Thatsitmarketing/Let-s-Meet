---
/**
 * Kalender für das Backoffice: Verfügbarkeit als Fläche, Termine als Blöcke, Google Termine mit Titel (grau),
 * dahinter schraffiert die Zeit, die sie samt Puffer blockieren. Ganztägige Google Einträge stehen über dem Raster.
 * Wird auf „Termine“ und „Verfügbarkeit“ genutzt, Navigation läuft über die URL (kal, datum).
 */
import Icon from './ui/Icon.astro';
import type { KalDaten } from '../lib/kalender';

interface Props {
  daten: KalDaten;
  /** Ziel beim Klick auf einen Tageskopf in der Wochenansicht */
  tagLink?: (datum: string) => string;
  tagLinkLabel?: string;
  /** Aktiviert die Live Vorschau der Wochenzeiten (Verfügbarkeit) */
  vorschau?: boolean;
}

const { daten, tagLink, tagLinkLabel = 'Tag öffnen', vorschau = false } = Astro.props;
const woche = daten.ansicht === 'woche';
const KURZ = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
const LANG = ['Sonntag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag'];
const hhmm = (min: number) => `${String(Math.floor(min / 60)).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`;

const link = (aenderung: Record<string, string>) => {
  const p = new URLSearchParams(Astro.url.searchParams);
  for (const k of ['ok', 'fehler', 'seite', 'ausnahme']) p.delete(k);
  for (const [k, v] of Object.entries(aenderung)) p.set(k, v);
  return `${Astro.url.pathname}?${p}#kalender`;
};

const stunden: number[] = [];
for (let m = daten.vonMin; m < daten.bisMin; m += 60) stunden.push(m);
const tagNr = (datum: string) => Number(datum.slice(8, 10));
const zeitenText = (t: KalDaten['tage'][number]) =>
  t.verfuegbar.length ? t.verfuegbar.map((s) => `${hhmm(s.start)} bis ${hhmm(s.ende)}`).join(', ') : 'Nicht verfügbar';
const MAX_MONAT = 3;
const mitGanztags = woche && daten.tage.some((t) => t.ganztags.length > 0);
const standText = (() => {
  if (!daten.googleStand) return 'noch nicht abgeglichen';
  const min = Math.round((Date.now() - Date.parse(daten.googleStand)) / 60_000);
  return min < 1 ? 'gerade abgeglichen' : min < 60 ? `abgeglichen vor ${min} Min.` : `abgeglichen ${new Intl.DateTimeFormat('de-DE', { timeZone: daten.tz, day: 'numeric', month: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(daten.googleStand))} Uhr`;
})();
type Eintrag = { art: 'termin'; start: number; b: KalDaten['tage'][number]['termine'][number] } | { art: 'google'; start: number; g: KalDaten['tage'][number]['google'][number] };
const monatsEintraege = (t: KalDaten['tage'][number]): Eintrag[] =>
  [
    ...t.termine.map((b) => ({ art: 'termin' as const, start: b.start, b })),
    ...t.google.map((g) => ({ art: 'google' as const, start: g.start, g })),
  ].sort((a, b) => a.start - b.start);
// Google Termine öffnen sich im Backoffice, dort gibt es auch den Link zu Google
const googleHref = (eventId: string) => `/app/termine/google/${encodeURIComponent(eventId)}`;
const googleTitel = (g: KalDaten['tage'][number]['google'][number]) =>
  `${g.zeit}: ${g.titel} (Google Kalender${g.blockiert ? '' : ', blockiert nicht'})${g.ort ? `, ${g.ort}` : ''}`;
---
<section class="kal karte" id="kalender" aria-labelledby="kal-titel" data-ansicht={daten.ansicht}>
  <header class="kal-kopf">
    <div class="kal-titel">
      <h2 id="kal-titel">{daten.titel}</h2>
      <p class="leise klein">{daten.team ? 'Termine des ganzen Teams' : 'Termine und Verfügbarkeit'}, Zeitzone {daten.tz.replace(/_/g, ' ')}</p>
    </div>
    <div class="kal-steuer">
      <a class="knopf knopf--rahmen knopf--klein" href={link({ datum: daten.heute })}>Heute</a>
      <div class="kal-pfeile">
        <a class="pfeil" href={link({ datum: daten.zurueck })} aria-label={woche ? 'Vorherige Woche' : 'Vorheriger Monat'}><Icon name="links" /></a>
        <a class="pfeil" href={link({ datum: daten.weiter })} aria-label={woche ? 'Nächste Woche' : 'Nächster Monat'}><Icon name="rechts" /></a>
      </div>
      <nav class="kal-umschalter" aria-label="Kalenderansicht">
        <a href={link({ kal: 'woche' })} aria-current={woche ? 'page' : undefined}>Woche</a>
        <a href={link({ kal: 'monat' })} aria-current={!woche ? 'page' : undefined}>Monat</a>
      </nav>
    </div>
  </header>

  {woche ? (
    <div class="kal-scroll">
      <div class:list={['kw', { 'mit-ganztags': mitGanztags }]} style={`--v:${daten.vonMin}; --stunden:${stunden.length}`} data-von-min={daten.vonMin} data-bis-min={daten.bisMin}>
        <div class="kw-ecke" aria-hidden="true"></div>
        {daten.tage.map((t) => {
          const inhalt = (
            <>
              <span class="kw-wt">{KURZ[t.wochentag]}</span>
              <span class="kw-nr">{tagNr(t.datum)}</span>
              {t.ausnahme === 'frei' && <span class="kw-marke">Frei</span>}
              {t.ausnahme === 'zeiten' && <span class="kw-marke">Ausnahme</span>}
            </>
          );
          return tagLink ? (
            <a class:list={['kw-tagkopf', { heute: t.heute, vergangen: t.vergangen }]} href={tagLink(t.datum)} aria-label={`${tagLinkLabel}: ${LANG[t.wochentag]}, ${tagNr(t.datum)}.`} title={tagLinkLabel}>{inhalt}</a>
          ) : (
            <div class:list={['kw-tagkopf', { heute: t.heute, vergangen: t.vergangen }]}>{inhalt}</div>
          );
        })}
        {mitGanztags && (
          <>
            <div class="kw-ganz-ecke">Ganztägig</div>
            {daten.tage.map((t) => (
              <ul class="kw-ganz" role="list" aria-label={`Ganztägig am ${tagNr(t.datum)}.`}>
                {t.ganztags.map((g) => (
                  <li>
                    <a href={googleHref(g.eventId)} title={`${g.titel} (ganztägig, Google Kalender)`}>{g.titel}</a>
                  </li>
                ))}
              </ul>
            ))}
          </>
        )}
        <div class="kw-achse" aria-hidden="true">
          {stunden.map((m) => <span style={`--a:${m}`}>{hhmm(m)}</span>)}
        </div>
        {daten.tage.map((t) => (
          <div
            class:list={['kw-spalte', { heute: t.heute, vergangen: t.vergangen }]}
            data-wochentag={t.wochentag}
            data-ausnahme={t.ausnahme === 'keine' ? '0' : '1'}
            aria-label={`${LANG[t.wochentag]}, ${tagNr(t.datum)}.: ${zeitenText(t)}, ${t.termine.length} ${t.termine.length === 1 ? 'Termin' : 'Termine'}`}
            role="group"
          >
            {t.verfuegbar.map((s) => <div class="kw-frei" style={`--a:${s.start}; --d:${s.ende - s.start}`}></div>)}
            {t.belegt.map((s) => (
              <div class="kw-belegt" style={`--a:${s.start}; --d:${s.ende - s.start}`} title={`Nicht buchbar wegen Google Termin (inklusive ${30} Min. Puffer), ${hhmm(s.start)} bis ${hhmm(s.ende)}`}></div>
            ))}
            {t.google.map((g) => {
              const klassen = ['kw-termin', 'kw-google', { kurz: g.ende - g.start <= 30, mittel: g.ende - g.start < 60, eng: g.spalten > 1, vergangen: g.vergangen, frei: !g.blockiert }];
              const stil = `--a:${g.start}; --d:${g.ende - g.start}; --sp:${g.spalte}; --sps:${g.spalten}`;
              const inhalt = (
                <>
                  <span class="kw-t-zeit">{g.zeit.split(' bis ')[0]}<span class="kw-t-bis"> bis {g.zeit.split(' bis ')[1]}</span></span>
                  <strong class="kw-t-gast">{g.titel}</strong>
                  <span class="kw-t-art">Google Kalender{g.ort && ` · ${g.ort}`}</span>
                </>
              );
              return <a class:list={klassen} style={stil} href={googleHref(g.eventId)} title={googleTitel(g)}>{inhalt}</a>;
            })}
            {t.termine.map((b) => (
              <a
                class:list={['kw-termin', { kurz: b.ende - b.start <= 30, mittel: b.ende - b.start < 60, eng: b.spalten > 1, vergangen: b.vergangen, fehlt: b.nichtErschienen }]}
                href={`/app/termine/${b.id}`}
                style={`--a:${b.start}; --d:${b.ende - b.start}; --farbe:${b.farbe}; --sp:${b.spalte}; --sps:${b.spalten}`}
                title={`${b.zeit}: ${b.gast}, ${b.titel}${daten.team ? ` bei ${b.gastgeber}` : ''}`}
              >
                <span class="kw-t-zeit">{b.zeit.split(' bis ')[0]}<span class="kw-t-bis"> bis {b.zeit.split(' bis ')[1]}</span></span>
                <strong class="kw-t-gast">{b.gast}</strong>
                <span class="kw-t-art">{b.titel}{daten.team && ` · ${b.gastgeber}`}</span>
              </a>
            ))}
            {t.heute && daten.jetztMin !== null && daten.jetztMin >= daten.vonMin && daten.jetztMin <= daten.bisMin && (
              <div class="kw-jetzt" style={`--a:${daten.jetztMin}`} aria-hidden="true"></div>
            )}
          </div>
        ))}
      </div>
    </div>
  ) : (
    <div class="km">
      <div class="km-kopfzeile" aria-hidden="true">
        {[1, 2, 3, 4, 5, 6, 0].map((w) => <span>{KURZ[w]}</span>)}
      </div>
      <ol class="km-raster" role="list">
        {daten.tage.map((t) => (
          <li class:list={['km-tag', { heute: t.heute, vergangen: t.vergangen, fremd: !t.imMonat, zu: t.verfuegbar.length === 0 }]}>
            <div class="km-kopf">
              <a class="km-nr" href={link({ kal: 'woche', datum: t.datum })} aria-label={`Woche ab ${tagNr(t.datum)}. öffnen`}>{tagNr(t.datum)}</a>
              {t.ausnahme === 'frei' && <span class="kw-marke">Frei</span>}
              {t.ausnahme === 'zeiten' && <span class="kw-marke">Ausnahme</span>}
            </div>
            <p class="km-zeiten">{zeitenText(t)}</p>
            {t.ganztags.length > 0 && (
              <p class="km-ganz" title={t.ganztags.map((g) => g.titel).join(', ')}>{t.ganztags.map((g) => g.titel).join(', ')}</p>
            )}
            {monatsEintraege(t).length > 0 && (
              <ul class="km-termine" role="list">
                {monatsEintraege(t).slice(0, MAX_MONAT).map((e) => (
                  <li>
                    {e.art === 'termin' ? (
                      <a href={`/app/termine/${e.b.id}`} class:list={{ vergangen: e.b.vergangen }} style={`--farbe:${e.b.farbe}`} title={`${e.b.zeit}: ${e.b.gast}, ${e.b.titel}`}>
                        <span class="km-zeit">{hhmm(e.b.start)}</span><span class="km-gast">{e.b.gast}</span>
                      </a>
                    ) : (
                      <a href={googleHref(e.g.eventId)} class:list={['km-google', { vergangen: e.g.vergangen, frei: !e.g.blockiert }]} title={googleTitel(e.g)}>
                        <span class="km-zeit">{hhmm(e.g.start)}</span><span class="km-gast">{e.g.titel}</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {monatsEintraege(t).length > MAX_MONAT && (
              <a class="km-mehr" href={link({ kal: 'woche', datum: t.datum })}>+{monatsEintraege(t).length - MAX_MONAT} weitere</a>
            )}
            <span class="km-punkte" aria-hidden="true">
              {t.termine.slice(0, 4).map((b) => <i style={`--farbe:${b.farbe}`}></i>)}
            </span>
          </li>
        ))}
      </ol>
    </div>
  )}

  <footer class="kal-legende" aria-label="Legende">
    <span><i class="lg lg-frei"></i>Buchbar</span>
    <span><i class="lg lg-zu"></i>Nicht buchbar</span>
    <span><i class="lg lg-termin"></i>Termin</span>
    {daten.google && <span><i class="lg lg-google"></i>Google Kalender</span>}
    {daten.google && <span><i class="lg lg-belegt"></i>Gesperrt durch Google Termin (mit 30 Min. Puffer)</span>}
    {daten.google && (
      <span class:list={['kal-stand', { fehler: daten.googleFehler }]} title={daten.googleFehler ?? undefined}>
        <Icon name={daten.googleFehler ? 'info' : 'kalender'} groesse={16} />
        Google {daten.googleFehler ? `nicht erreichbar, Stand: ${standText}` : standText}
      </span>
    )}
    {vorschau && <span class="kal-vorschau" hidden><Icon name="info" groesse={16} />Vorschau mit ungespeicherten Wochenzeiten</span>}
  </footer>
</section>

<style>
  .kal { display: grid; min-width: 0; }
  .kal-kopf {
    display: flex; justify-content: space-between; align-items: center; gap: var(--raum-4); flex-wrap: wrap;
    padding: var(--raum-4) var(--raum-6); border-bottom: 1px solid var(--farbe-rahmen);
  }
  .kal-titel { display: grid; gap: 2px; min-width: 0; }
  .kal-titel h2 { font-family: var(--schrift-text); font-weight: 600; font-size: var(--text-h4); letter-spacing: 0; line-height: 1.3; }
  .kal-steuer { display: flex; align-items: center; gap: var(--raum-3); flex-wrap: wrap; }
  .kal-pfeile { display: flex; }
  .pfeil {
    display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--farbe-rahmen-stark); color: var(--n-900); text-decoration: none;
  }
  main .pfeil { padding: 0; }
  .pfeil + .pfeil { border-left: 0; }
  .pfeil:hover { background: var(--n-900); color: var(--farbe-papier); border-color: var(--n-900); }
  .kal-umschalter { display: flex; }
  .kal-umschalter a {
    display: inline-flex; align-items: center; min-height: 36px; padding: 0 var(--raum-4); border: 1px solid var(--farbe-rahmen-stark);
    font-weight: 600; font-size: var(--text-sm); text-decoration: none; color: var(--farbe-text-2);
  }
  .kal-umschalter a + a { border-left: 0; }
  .kal-umschalter a[aria-current='page'] { background: var(--n-900); border-color: var(--n-900); color: var(--farbe-papier); }

  /* Wochenansicht */
  .kal-scroll { overflow-x: auto; overscroll-behavior-x: contain; }
  .kw {
    --h: 60px;
    --schraffur: repeating-linear-gradient(135deg, var(--n-100) 0 6px, var(--n-050) 6px 12px);
    display: grid; grid-template-columns: 56px repeat(7, minmax(96px, 1fr)); grid-template-rows: auto calc(var(--stunden) * var(--h));
    min-width: 728px;
  }
  .kw.mit-ganztags { grid-template-rows: auto auto calc(var(--stunden) * var(--h)); }
  .kw-ganz-ecke {
    font-size: 0.6875rem; color: var(--farbe-text-leise); text-align: right; padding: 6px var(--raum-2) 6px 0; border-bottom: 1px solid var(--farbe-rahmen);
  }
  .kw-ganz { list-style: none; margin: 0; padding: 4px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; align-content: start; overflow: hidden; border-left: 1px solid var(--farbe-rahmen); border-bottom: 1px solid var(--farbe-rahmen); min-width: 0; }
  .kw-ganz a, .kw-ganz span {
    display: block; padding: 1px 6px; background: var(--n-100); border-left: 3px solid var(--n-500); color: var(--n-800);
    font-size: 0.75rem; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none;
  }
  .kw-ganz li { min-width: 0; }
  main .kw-ganz a { padding: 1px 6px; }
  .kw-ganz a:hover { background: var(--n-200); }
  .kw-ecke { border-bottom: 1px solid var(--farbe-rahmen); }
  .kw-tagkopf {
    display: flex; align-items: center; gap: var(--raum-2); flex-wrap: wrap; padding: var(--raum-3) var(--raum-3);
    border-bottom: 1px solid var(--farbe-rahmen); border-left: 1px solid var(--farbe-rahmen); text-decoration: none; color: inherit; min-height: 56px;
  }
  main a.kw-tagkopf { padding-block: var(--raum-3); }
  a.kw-tagkopf:hover { background: var(--n-050); }
  a.kw-tagkopf:hover .kw-nr { text-decoration: underline; text-decoration-color: var(--farbe-akzent); }
  .kw-wt { font-family: var(--schrift-label); font-weight: 500; letter-spacing: var(--sperrung-knopf); text-transform: uppercase; font-size: 0.875rem; color: var(--farbe-text-2); }
  .kw-nr { font-family: var(--schrift-display); font-weight: 900; font-size: 1.375rem; line-height: 1; min-width: 1.6em; text-align: center; padding: 4px 2px 2px; }
  .kw-tagkopf.heute .kw-nr { background: var(--n-900); color: var(--farbe-papier); }
  .kw-tagkopf.heute .kw-wt { color: var(--n-900); }
  .kw-tagkopf.vergangen .kw-nr, .kw-tagkopf.vergangen .kw-wt { color: var(--n-400); }
  .kw-marke {
    font-size: 0.75rem; font-weight: 600; padding: 1px 8px; border-radius: var(--radius-pille); background: var(--n-100); color: var(--n-700); white-space: nowrap;
  }
  .kw-achse { position: relative; }
  .kw-achse span {
    position: absolute; right: var(--raum-2); top: calc((var(--a) - var(--v)) * var(--h) / 60); transform: translateY(-50%);
    font-size: 0.75rem; color: var(--farbe-text-leise); font-variant-numeric: tabular-nums; background: var(--farbe-papier); padding: 0 2px;
  }
  .kw-achse span:first-child { transform: none; }
  .kw-spalte { position: relative; border-left: 1px solid var(--farbe-rahmen); background: var(--schraffur); overflow: hidden; }
  .kw-spalte::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: repeating-linear-gradient(to bottom, var(--farbe-rahmen) 0 1px, transparent 1px var(--h));
  }
  .kw-spalte.vergangen::after { content: ''; position: absolute; inset: 0; background: rgba(255, 255, 255, 0.45); z-index: 2; pointer-events: none; }
  /* .kw-frei global, weil die Live Vorschau der Verfügbarkeit diese Blöcke per Skript erzeugt */
  .kw-spalte > :global(.kw-frei), .kw-belegt, .kw-termin, .kw-jetzt {
    position: absolute; top: calc((var(--a) - var(--v)) * var(--h) / 60);
  }
  .kw-spalte > :global(.kw-frei) { left: 0; right: 0; height: calc(var(--d) * var(--h) / 60); background: var(--farbe-papier); }
  .kw-belegt {
    left: 3px; right: 3px; height: calc(var(--d) * var(--h) / 60); z-index: 2;
    background: repeating-linear-gradient(135deg, var(--n-200) 0 4px, var(--n-100) 4px 8px); border: 1px dashed var(--n-400);
  }
  .kw-termin {
    --breite: calc((100% - 8px) / var(--sps));
    left: calc(4px + var(--breite) * var(--sp)); width: calc(var(--breite) - 2px);
    height: max(20px, calc(var(--d) * var(--h) / 60 - 2px)); z-index: 3;
    display: flex; flex-direction: column; gap: 1px; padding: 4px 6px 4px 9px; overflow: hidden;
    background: var(--farbe-papier); border: 1px solid var(--n-300); border-left: 4px solid var(--farbe); box-shadow: var(--schatten-2);
    text-decoration: none; color: var(--n-900); font-size: 0.75rem; line-height: 1.3;
    transition: box-shadow var(--dauer-schnell) var(--kurve), transform var(--dauer-schnell) var(--kurve);
  }
  main a.kw-termin { padding-block: 4px; }
  .kw-termin:hover { box-shadow: var(--schatten-3); z-index: 5; border-color: var(--n-900); border-left-color: var(--farbe); }
  .kw-termin > * { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .kw-t-zeit { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--farbe-text-2); }
  .kw-t-gast { font-size: 0.8125rem; }
  .kw-t-art { color: var(--farbe-text-leise); }
  .kw-termin.kurz { flex-direction: row; align-items: center; gap: var(--raum-2); padding-block: 0; }
  main a.kw-termin.kurz { padding-block: 0; }
  .kw-termin.kurz .kw-t-bis, .kw-termin.mittel .kw-t-art, .kw-termin.kurz.eng .kw-t-zeit { display: none; }
  .kw-termin.eng .kw-t-bis { display: none; }
  .kw-termin.kurz > .kw-t-zeit { flex: none; overflow: visible; }
  .kw-termin.vergangen { box-shadow: none; opacity: 0.7; }
  .kw-termin.fehlt .kw-t-gast { text-decoration: line-through; }
  /* Google Termine: grau mit dunkler Kante, damit sie sich von Buchungen in Terminartfarbe abheben */
  .kw-google { --farbe: var(--n-600); background: var(--n-100); box-shadow: none; color: var(--n-800); }
  .kw-google .kw-t-art { color: var(--n-600); }
  .kw-google.frei { --farbe: var(--n-300); background: var(--farbe-papier); border-style: dashed; color: var(--n-600); }
  a.kw-google:hover { background: var(--farbe-papier); }
  .kw-jetzt { left: 0; right: 0; height: 2px; background: var(--farbe-akzent); z-index: 4; }
  .kw-jetzt::before { content: ''; position: absolute; left: -1px; top: -4px; width: 10px; height: 10px; background: var(--farbe-akzent); }

  /* Monatsansicht */
  .km-kopfzeile, .km-raster { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .km-kopfzeile span {
    padding: var(--raum-2) var(--raum-3); font-family: var(--schrift-label); font-weight: 500; letter-spacing: var(--sperrung-knopf); text-transform: uppercase;
    font-size: 0.875rem; color: var(--farbe-text-2); border-bottom: 1px solid var(--farbe-rahmen);
  }
  .km-raster { list-style: none; margin: 0; padding: 0; }
  .km-tag {
    min-height: 128px; padding: var(--raum-2) var(--raum-3) var(--raum-3); display: flex; flex-direction: column; gap: 4px; min-width: 0;
