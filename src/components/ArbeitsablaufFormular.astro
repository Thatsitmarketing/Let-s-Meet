---
import Icon from './ui/Icon.astro';
import {
  AKTIONEN, AUSLOESER, PLATZHALTER, VERSATZ, dauerText, vorlage,
  type Aktion, type ArbeitsablaufWerte, type Ausloeser,
} from '../lib/arbeitsablaeufe';
import type { Terminart } from '../lib/typen';

interface Props {
  werte: ArbeitsablaufWerte;
  fehler: Record<string, string>;
  neu: boolean;
  terminarten: Terminart[];
  bueroEmail: string;
}
const { werte: w, fehler, neu, terminarten, bueroEmail } = Astro.props;
const f = (name: string) => (fehler[name] ? { 'aria-invalid': 'true' as const, 'aria-describedby': `fehler-${name}` } : {});
// Vorschläge für alle Kombinationen, das Skript tauscht sie beim Wechsel, solange der Text unverändert ist
const vorlagen: Record<string, ReturnType<typeof vorlage>> = {};
for (const a of AUSLOESER) for (const k of AKTIONEN) vorlagen[`${a.wert}:${k.wert}`] = vorlage(a.wert as Ausloeser, k.wert as Aktion);
const versatzText = (a: Ausloeser, m: number) =>
  m === 0 ? (a === 'nach_ende' ? 'Direkt nach Ende' : 'Sofort') : `${dauerText(m)} ${a === 'vor_beginn' ? 'vorher' : 'danach'}`;
---
<form method="post" class="ab-form" id="ab-form" novalidate data-vorlagen={JSON.stringify(vorlagen)}>
  {Object.keys(fehler).length > 0 && (
    <p class="hinweis hinweis--fehler" role="alert"><Icon name="warnung" />Bitte prüf die markierten Felder.</p>
  )}

  <div class="spalten">
    <div class="spalte">
      <section class="block karte" aria-labelledby="a-name">
        <h2 id="a-name">Name</h2>
        <div class="feld">
          <label for="name">Name des Arbeitsablaufs<span class="pflicht" aria-hidden="true">*</span></label>
          <input id="name" name="name" class="eingabe" maxlength="120" required value={w.name} placeholder="z. B. Erinnerung 24 Stunden vorher" {...f('name')} />
          {fehler.name && <p class="fehlertext" id="fehler-name">{fehler.name}</p>}
        </div>
        <label class="schalter"><input type="checkbox" name="aktiv" checked={Boolean(w.aktiv)} />Aktiv, Mails gehen raus</label>
      </section>

      <section class="block karte" aria-labelledby="a-wenn">
        <h2 id="a-wenn">Wenn das passiert</h2>
        <div class="wahl" role="radiogroup" aria-labelledby="a-wenn">
          {AUSLOESER.map((a) => (
            <label class="option">
              <input type="radio" name="ausloeser" value={a.wert} checked={w.ausloeser === a.wert} />
              <span><strong>{a.text}</strong><small>{a.hilfe}</small></span>
            </label>
          ))}
        </div>
        {AUSLOESER.filter((a) => VERSATZ[a.wert].length > 1).map((a) => (
          <div class="feld versatz" data-fuer={a.wert} hidden={w.ausloeser !== a.wert}>
            <label for={`versatz_${a.wert}`}>Zeitpunkt</label>
            <select id={`versatz_${a.wert}`} name={`versatz_${a.wert}`} class="auswahl" disabled={w.ausloeser !== a.wert}>
              {VERSATZ[a.wert].map((m) => (
                <option value={m} selected={w.ausloeser === a.wert ? w.versatz_min === m : m === (a.wert === 'vor_beginn' ? 1440 : 0)}>{versatzText(a.wert, m)}</option>
              ))}
            </select>
          </div>
        ))}
        <p class="hilfe" id="hilfe-zeit">Zeitversetzte Mails prüft das System alle 10 Minuten. Bucht jemand kurzfristiger, als die Erinnerung vorsieht, entfällt sie. Sind mehrere Erinnerungen an den Gast gleichzeitig fällig, geht nur die kürzeste raus.</p>
      </section>

      <section class="block karte" aria-labelledby="a-tun">
        <h2 id="a-tun">Das tun</h2>
        <div class="wahl wahl--drei" role="radiogroup" aria-labelledby="a-tun">
          {AKTIONEN.map((k) => (
            <label class="option">
              <input type="radio" name="aktion" value={k.wert} checked={w.aktion === k.wert} />
              <span><strong>{k.text}</strong><small>{k.wert === 'mail_gast' ? 'An die Adresse aus der Buchung' : k.wert === 'mail_buero' ? bueroEmail : 'Bis zu fünf Adressen'}</small></span>
            </label>
          ))}
        </div>
        <div class="feld" id="feld-empfaenger" hidden={w.aktion !== 'mail_an'}>
          <label for="empfaenger">Empfänger</label>
          <input id="empfaenger" name="empfaenger" class="eingabe" maxlength="600" value={w.empfaenger ?? ''} placeholder="name@thatsit.marketing, zweite@firma.de" {...f('empfaenger')} />
          <p class="hilfe">Mehrere Adressen mit Komma trennen. Antworten gehen an den Gast.</p>
          {fehler.empfaenger && <p class="fehlertext" id="fehler-empfaenger">{fehler.empfaenger}</p>}
        </div>
      </section>

      <section class="block karte" aria-labelledby="a-fuer">
        <h2 id="a-fuer">Gilt für</h2>
        <label class="schalter"><input type="checkbox" name="alle_terminarten" id="alle_terminarten" checked={Boolean(w.alle_terminarten)} />Alle Terminarten, auch künftige</label>
        <fieldset class="arten" id="arten" disabled={Boolean(w.alle_terminarten)}>
          <legend class="sr-only">Einzelne Terminarten</legend>
          {terminarten.map((t) => (
            <label class="haken art">
              <input type="checkbox" name="terminarten" value={t.id} checked={Boolean(w.alle_terminarten) || w.terminarten.includes(t.id)} />
              <span class="punkt-farbe" style={`background:${t.farbe}`} aria-hidden="true"></span>
              <span>{t.titel}{!t.aktiv && <span class="leise"> (nicht aktiv)</span>}</span>
            </label>
          ))}
        </fieldset>
        <p class="hilfe">Die Zuordnung lässt sich auch in jeder Terminart unter „Benachrichtigungen und Arbeitsabläufe“ ändern.</p>
      </section>
    </div>

    <div class="spalte">
      <section class="block karte" aria-labelledby="a-mail">
        <h2 id="a-mail">Mail</h2>
        <div class="feld">
          <label for="betreff">Betreff<span class="pflicht" aria-hidden="true">*</span></label>
          <input id="betreff" name="betreff" class="eingabe" maxlength="200" value={w.betreff} data-platz {...f('betreff')} />
          {fehler.betreff && <p class="fehlertext" id="fehler-betreff">{fehler.betreff}</p>}
        </div>
        <div class="feld">
          <label for="ueberschrift">Überschrift in der Mail<span class="leise"> (optional)</span></label>
          <input id="ueberschrift" name="ueberschrift" class="eingabe" maxlength="160" value={w.ueberschrift ?? ''} data-platz />
        </div>
        <div class="feld">
          <label for="text">Text<span class="pflicht" aria-hidden="true">*</span></label>
          <textarea id="text" name="text" class="textfeld text-gross" maxlength="5000" data-platz {...f('text')}>{w.text}</textarea>
          {fehler.text && <p class="fehlertext" id="fehler-text">{fehler.text}</p>}
          <p class="hilfe">Unter dem Text ergänzen wir automatisch die Termindaten und passende Knöpfe: für den Gast „Zum Meeting“ und „Umbuchen oder absagen“ vor dem Termin, „Neuen Termin buchen“ danach, für das Büro „Im Backoffice öffnen“. Zeilen wie „Telefon: {'{telefon}'}“ fallen weg, wenn der Wert leer ist.</p>
        </div>
        <div class="platzhalter">
          <p class="feld-label">Platzhalter einfügen</p>
          <div class="chips">
            {PLATZHALTER.map((p) => (
              <button type="button" class="chip" data-einfuegen={`{${p.name}}`} title={p.text}>{`{${p.name}}`}</button>
            ))}
          </div>
          <p class="hilfe">Ein Klick fügt den Platzhalter an der Cursorposition im zuletzt gewählten Feld ein.</p>
        </div>
        <button type="button" class="knopf knopf--leise knopf--klein" id="vorlage-laden"><Icon name="umbuchen" />Vorschlag für diesen Auslöser laden</button>
      </section>
    </div>
  </div>

  <div class="leiste">
    <a class="knopf knopf--leise" href="/app/arbeitsablaeufe">Abbrechen</a>
    {!neu && <button type="submit" class="knopf knopf--rahmen" name="aktion_formular" value="testen" title={`Speichert und schickt eine Testmail mit Beispieldaten an deine Adresse`}><Icon name="mail" />Speichern und Testmail</button>}
    <button type="submit" class="knopf knopf--orange" name="aktion_formular" value="speichern">{neu ? 'Arbeitsablauf anlegen' : 'Speichern'}</button>
  </div>
</form>

<script>
  const form = document.getElementById('ab-form') as HTMLFormElement;
  const vorlagen = JSON.parse(form.dataset.vorlagen || '{}') as Record<string, { betreff: string; ueberschrift: string; text: string }>;
  const felder = {
    betreff: form.querySelector<HTMLInputElement>('#betreff')!,
    ueberschrift: form.querySelector<HTMLInputElement>('#ueberschrift')!,
    text: form.querySelector<HTMLTextAreaElement>('#text')!,
  };
  const wert = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';
  let schluessel = `${wert('ausloeser')}:${wert('aktion')}`;

  // Vorschlag übernehmen, solange der Text noch dem alten Vorschlag entspricht oder leer ist
  const vorschlag = (erzwingen: boolean) => {
    const alt = vorlagen[schluessel];
    schluessel = `${wert('ausloeser')}:${wert('aktion')}`;
    const neu = vorlagen[schluessel];
    if (!neu) return;
    (Object.keys(felder) as (keyof typeof felder)[]).forEach((k) => {
      const feld = felder[k];
      if (erzwingen || !feld.value.trim() || (alt && feld.value === alt[k])) feld.value = neu[k];
    });
  };

  const anzeigen = () => {
    const ausloeser = wert('ausloeser');
    form.querySelectorAll<HTMLElement>('.versatz').forEach((v) => {
      const aktiv = v.dataset.fuer === ausloeser;
      v.hidden = !aktiv;
      v.querySelector('select')!.disabled = !aktiv;
    });
    document.getElementById('feld-empfaenger')!.hidden = wert('aktion') !== 'mail_an';
  };
  form.querySelectorAll('input[name="ausloeser"], input[name="aktion"]').forEach((r) =>
    r.addEventListener('change', () => { anzeigen(); vorschlag(false); }),
  );
  anzeigen();
  document.getElementById('vorlage-laden')!.addEventListener('click', () => {
    if (window.confirm('Betreff, Überschrift und Text durch den Vorschlag ersetzen?')) vorschlag(true);
  });

  // Alle Terminarten schaltet die Einzelauswahl
  const alleSchalter = document.getElementById('alle_terminarten') as HTMLInputElement;
  const arten = document.getElementById('arten') as HTMLFieldSetElement;
  alleSchalter.addEventListener('change', () => {
    arten.disabled = alleSchalter.checked;
    if (alleSchalter.checked) arten.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = true));
  });

  // Platzhalter einfügen
  let letztes: HTMLInputElement | HTMLTextAreaElement = felder.text;
  form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-platz]').forEach((f) => f.addEventListener('focus', () => (letztes = f)));
  form.querySelectorAll<HTMLButtonElement>('[data-einfuegen]').forEach((k) =>
    k.addEventListener('click', () => {
      const t = k.dataset.einfuegen!;
      const start = letztes.selectionStart ?? letztes.value.length;
      const ende = letztes.selectionEnd ?? start;
      letztes.value = letztes.value.slice(0, start) + t + letztes.value.slice(ende);
      letztes.focus();
      letztes.setSelectionRange(start + t.length, start + t.length);
    }),
  );
</script>

<style>
  .ab-form { display: grid; gap: var(--raum-6); }
  .spalten, .spalte { display: grid; gap: var(--raum-6); align-content: start; min-width: 0; }
  @media (min-width: 1300px) { .spalten { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } }
  .block { padding: var(--raum-8); display: grid; gap: var(--raum-5, 1.25rem); }
  .block h2 { font-family: var(--schrift-text); font-weight: 600; font-size: var(--text-h4); letter-spacing: 0; }
  .wahl { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: var(--raum-2); }
  .option input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .option span {
    display: grid; gap: 4px; height: 100%; padding: var(--raum-3) var(--raum-4); border: 1px solid var(--farbe-rahmen-stark);
    cursor: pointer; font-size: var(--text-sm); border-radius: var(--radius-s);
  }
  .option small { color: var(--farbe-text-leise); font-size: 0.8125rem; line-height: 1.4; }
  .option input:checked + span { border-color: var(--n-900); box-shadow: inset 0 0 0 1px var(--n-900); background: var(--n-050); }
  .option input:focus-visible + span { outline: 2px solid var(--n-900); outline-offset: 2px; }
  .versatz { max-width: 320px; }
  .arten { border: 0; margin: 0; padding: 0; display: grid; gap: var(--raum-3); min-width: 0; }
  .arten:disabled { opacity: 0.55; }
  .art { align-items: center; }
  .punkt-farbe { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .text-gross { min-height: 240px; }
  .platzhalter { display: grid; gap: var(--raum-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    font: inherit; font-size: 0.8125rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; padding: 6px 10px;
    background: var(--n-050); border: 1px solid var(--farbe-rahmen-stark); border-radius: var(--radius-s); cursor: pointer;
  }
  .chip:hover { border-color: var(--n-900); background: var(--farbe-papier); }
  .block > * { min-width: 0; }
  #vorlage-laden { justify-self: start; white-space: normal; text-align: left; }
  .leiste {
    position: sticky; bottom: 0; display: flex; justify-content: flex-end; gap: var(--raum-2); flex-wrap: wrap;
    padding: var(--raum-4) 0; background: var(--farbe-flaeche-alt); border-top: 1px solid var(--farbe-rahmen);
  }
  @media (max-width: 640px) {
    .block { padding: var(--raum-6) var(--raum-4); }
  }
</style>
