# Lokal als .dev.vars anlegen, in Cloudflare als Secret (wrangler secret put NAME) setzen.
# Hier stehen nur Namen und Zweck, nie echte Werte.

SESSION_SECRET=              # Signatur der Backoffice Sitzung, mindestens 32 zufällige Zeichen
SETUP_TOKEN=                 # einmaliger Schlüssel für die Ersteinrichtung unter /app/setup
CRON_SECRET=                 # schützt /api/cron, falls die Erinnerungen extern ausgelöst werden

RESEND_API_KEY=              # Versand aller Terminmails über Resend
# MAIL_FROM und MAIL_REPLY_TO stehen als vars in wrangler.jsonc

PUBLIC_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile Widget im Buchungsformular
TURNSTILE_SECRET_KEY=        # serverseitige Prüfung des Turnstile Tokens
ANFRAGE_SCHLUESSEL=         # Secret, gemeinsamer Schluessel mit dem Website Entwurf Funnel fuer /api/anfrage (mindestens 24 Zeichen)
PLAYBOOK_SCHLUESSEL=        # Secret, gemeinsamer Schluessel der vier Playbook Landingpages fuer /api/playbook/anfordern (mindestens 24 Zeichen)

GOOGLE_CLIENT_ID=            # OAuth Client für die Google Kalender Verbindung
GOOGLE_CLIENT_SECRET=        # OAuth Secret dazu

# SITE_URL steht als var in wrangler.jsonc (öffentliche Adresse der App)

# WhatsApp Bot (siehe docs/whatsapp-bot.md), alles als Secret
WHATSAPP_TOKEN=              # dauerhafter Token des Systemnutzers bei Meta
WHATSAPP_PHONE_NUMBER_ID=    # Phone number ID der Firmennummer (nicht die Nummer selbst)
WHATSAPP_APP_SECRET=         # App Secret der Meta App, prüft die Signatur des Webhooks und tauscht den Embedded Signup Code (/app/whatsapp/coexistence)
WHATSAPP_VERIFY_TOKEN=       # frei gewählt, beim Eintragen des Webhooks bei Meta angeben
WHATSAPP_LEAD_SCHLUESSEL=    # gemeinsamer Schlüssel mit der Landingpage (dort BOT_SCHLUESSEL), mindestens 24 Zeichen
ANTHROPIC_API_KEY=           # Claude für freie Antworten und Einwandbehandlung
# WHATSAPP_TERMINART, WHATSAPP_TEAM_EMAIL, WHATSAPP_APP_ID und WHATSAPP_EMBEDDED_CONFIG_ID stehen als vars in wrangler.jsonc,
# optional WHATSAPP_API_VERSION (Standard v24.0), WHATSAPP_KI_MODELL (Standard claude-opus-5-5)
# Höchstens so viele Aufrufe von Claude am Tag über alle WhatsApp Chats (Standard 1500)
WHATSAPP_KI_TAGESLIMIT=
