# Lokal als .dev.vars anlegen, in Cloudflare als Secret (wrangler secret put NAME) setzen.
# Hier stehen nur Namen und Zweck, nie echte Werte.

SESSION_SECRET=              # Signatur der Backoffice Sitzung, mindestens 32 zufällige Zeichen
SETUP_TOKEN=                 # einmaliger Schlüssel für die Ersteinrichtung unter /app/setup
CRON_SECRET=                 # schützt /api/cron, falls die Erinnerungen extern ausgelöst werden

RESEND_API_KEY=              # Versand aller Terminmails über Resend
# MAIL_FROM und MAIL_REPLY_TO stehen als vars in wrangler.jsonc

PUBLIC_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile Widget im Buchungsformular
TURNSTILE_SECRET_KEY=        # serverseitige Prüfung des Turnstile Tokens
PLAYBOOK_SCHLUESSEL=        # Secret, gemeinsamer Schluessel der vier Playbook Landingpages fuer /api/playbook/anfordern (mindestens 24 Zeichen)

GOOGLE_CLIENT_ID=            # OAuth Client für die Google Kalender Verbindung
GOOGLE_CLIENT_SECRET=        # OAuth Secret dazu

# SITE_URL steht als var in wrangler.jsonc (öffentliche Adresse der App)
