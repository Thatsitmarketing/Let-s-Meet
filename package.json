{
  "name": "lets-meet",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "astro build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:cloudflare": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "astro": "7.4.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "4.152.0"
  }
}
