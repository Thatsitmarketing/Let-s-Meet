{
  // Cloudflare Workers Konfiguration für Let's Meet.
  // Schlüssel und Passwörter gehören NICHT hierher, sondern als Secret in Cloudflare
  // (wrangler secret put NAME). Lokal liegen sie in .dev.vars (nicht eingecheckt).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "let-s-meet",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Statische Dateien aus dist/client. Die Playbook Dateien gehen zuerst an den Worker,
  // damit sie nur mit gültigem persönlichem Link ausgeliefert werden (src/worker.ts)
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": ["/playbook-dateien/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terminethatsitmarketing",
      "database_id": "26aa6845-79a5-419a-9f2d-8ee308d6f37e",
      "migrations_dir": "migrations"
    }
  ],
  // Erinnerungsmails und Löschfristen laufen alle 10 Minuten
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "SITE_URL": "https://letsmeet.thatsit.marketing",
    "MAIL_FROM": "That's it. Marketing <termine@thatsit.marketing>",
    "MAIL_REPLY_TO": "info@thatsit.marketing"
  }
}
